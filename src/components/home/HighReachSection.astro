---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const highReachItems = [
  {
    title: "Básculas camioneras",
    text: "Soluciones de pesaje para entradas, salidas, patios logísticos, recepción de materiales y control de carga vehicular.",
    href: withBase("/basculas-camioneras/"),
    imageLabel: "Espacio para imagen de báscula camionera"
  },
  {
    title: "Plantas concreteras",
    text: "Sistemas de pesaje para operación de concreto, dosificación, agregados y procesos donde el control de peso impacta producción.",
    href: withBase("/plantas-concreteras/"),
    imageLabel: "Espacio para imagen de planta concretera"
  }
];
---

<section class="section high-reach" id="alto-alcance">
  <div class="section-inner">
    <div class="high-reach__heading">
      <p class="eyebrow">Soluciones de gran capacidad</p>
      <h2>Alto alcance</h2>
      <p>
        Equipos y sistemas pensados para empresas que necesitan control de peso en procesos de
        carga, producción, recepción y salida de materiales.
      </p>
    </div>

    <div class="high-reach__grid" aria-label="Soluciones de alto alcance">
      {highReachItems.map((item) => (
        <a class="high-reach__card" href={item.href}>
          <div class="high-reach__media" aria-label={item.imageLabel}>
            <!-- Futuro: colocar aquí la imagen real de la solución correspondiente. -->
            <span>{item.imageLabel}</span>
          </div>
          <div class="high-reach__content">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <strong>Conocer solución</strong>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .high-reach {
    background:
      linear-gradient(180deg, #f6f8fb 0%, #ffffff 100%);
    border-top: 1px solid rgba(174, 188, 204, 0.5);
  }

  .high-reach__heading {
    display: grid;
    justify-items: center;
    max-width: 840px;
    margin: 0 auto clamp(28px, 4vw, 46px);
    text-align: center;
  }

  .high-reach__heading h2 {
    margin-bottom: 14px;
    font-size: clamp(2rem, 3.5vw, 3.8rem);
  }

  .high-reach__heading p:last-child {
    max-width: 700px;
    margin: 0;
    color: var(--muted);
    font-size: 1.04rem;
  }

  .high-reach__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .high-reach__card {
    display: grid;
    grid-template-rows: minmax(260px, 0.92fr) auto;
    overflow: hidden;
    min-height: 520px;
    border: 1px solid rgba(174, 188, 204, 0.62);
    border-radius: 8px;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 44px rgba(8, 17, 28, 0.08);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .high-reach__card:hover {
    border-color: rgba(212, 33, 46, 0.42);
    box-shadow: 0 24px 56px rgba(8, 17, 28, 0.13);
    transform: translateY(-4px);
  }

  .high-reach__media {
    display: grid;
    place-items: center;
    min-height: 280px;
    padding: 24px;
    background:
      linear-gradient(135deg, rgba(47, 125, 246, 0.12), transparent 46%),
      repeating-linear-gradient(0deg, rgba(67, 95, 120, 0.12) 0 1px, transparent 1px 18px),
      #eef3f8;
  }

  .high-reach__media span {
    display: grid;
    place-items: center;
    width: min(420px, 100%);
    min-height: 180px;
    padding: 24px;
    border: 1px dashed rgba(67, 95, 120, 0.38);
    border-radius: 8px;
    color: #526276;
    font-size: 0.92rem;
    font-weight: 850;
    line-height: 1.3;
    text-align: center;
  }

  .high-reach__content {
    padding: 26px;
  }

  .high-reach__content h3 {
    margin-bottom: 12px;
    font-size: clamp(1.45rem, 2vw, 2rem);
  }

  .high-reach__content p {
    margin-bottom: 22px;
    color: var(--muted);
  }

  .high-reach__content strong {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--ink);
    border-radius: 6px;
    background: var(--ink);
    color: #ffffff;
    font-size: 0.92rem;
  }

  .high-reach__card:hover strong {
    border-color: var(--red);
    background: var(--red);
  }

  @media (max-width: 820px) {
    .high-reach__grid {
      grid-template-columns: 1fr;
    }

    .high-reach__card {
      min-height: auto;
    }
  }
</style>
