---
import SmartImage from "../SmartImage.astro";
import { contact } from "../../data/site";
import {
  getLowProfileLine,
  lowProfileDecisionPaths,
  lowProfileFaqs,
  lowProfileLines,
  type LowProfileLine
} from "../../data/lowProfileScales";

interface Props {
  view: "landing" | "product" | "comparator" | "guide";
  productSlug?: LowProfileLine["slug"];
}

const { view, productSlug } = Astro.props;
const currentLine = productSlug ? getLowProfileLine(productSlug) : undefined;
if (view === "product" && !currentLine) {
  throw new Error(`No existe la línea de bajo perfil: ${productSlug}`);
}

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const quoteAnchor = "#cotizar-bajo-perfil";
const comparatorHref = withBase("/basculas/bajo-perfil/comparador/");
const guideHref = withBase("/basculas/bajo-perfil/que-bascula-necesito/");
const landingHref = withBase("/basculas/bajo-perfil/");
const selectedLine = currentLine ?? lowProfileLines[2];
const whatsappMessage = encodeURIComponent(
  currentLine?.whatsappIntent ??
    "Hola, quiero cotizar una báscula de bajo perfil. Necesito asesoría para elegir capacidad, medidas y línea adecuada."
);
const whatsappHref = `${contact.whatsapp[0].href}?text=${whatsappMessage}`;
const contactSubject =
  view === "product"
    ? `Solicitud ${selectedLine.name}`
    : view === "comparator"
      ? "Solicitud desde comparador de básculas de bajo perfil"
      : view === "guide"
        ? "Solicitud desde guía de selección de báscula de bajo perfil"
        : "Solicitud desde landing de básculas de bajo perfil";
const formIntro =
  view === "guide"
    ? "Comparte cómo será la operación y te ayudamos a definir línea, capacidad y configuración."
    : view === "comparator"
      ? "Si ya tienes dos opciones en mente, envíanos los datos de operación y te ayudamos a cerrar la decisión."
      : "Cuéntanos qué necesitas pesar y te orientamos con una recomendación clara.";

const quickMetrics = [
  "Instalación sin obra civil en la mayoría de casos",
  "Rampa para patín o carga rodada",
  "Configuración por capacidad, medidas y ambiente"
];

const selectionFactors = [
  "Peso máximo real por tarima o carga",
  "Frecuencia diaria de pesaje",
  "Ingreso con patín, carro o montacargas",
  "Ambiente seco, húmedo, lavado o polvo",
  "Necesidad de tickets, reportes o control digital"
];

const applicationCards = [
  {
    title: "Almacenes",
    text: "Pesaje de mercancía en recepción, salida o control interno."
  },
  {
    title: "Centros de distribución",
    text: "Flujo constante de productos, tarimas y movimientos diarios."
  },
  {
    title: "Recibo de mercancía",
    text: "Verificación rápida de peso al recibir producto o materia prima."
  },
  {
    title: "Embarques",
    text: "Control de peso antes de salida, envío o entrega."
  },
  {
    title: "Producción",
    text: "Pesaje de insumos, producto terminado o procesos internos."
  },
  {
    title: "Industria alimentaria",
    text: "Ambientes donde importa la limpieza, control y resistencia."
  },
  {
    title: "Comercio mayorista",
    text: "Operaciones con volumen, carga frecuente y atención rápida."
  },
  {
    title: "Procesos con tarimas",
    text: "Uso con patín hidráulico, carros o movimientos sobre plataforma."
  }
];

const selectionChecklist = [
  {
    title: "Peso máximo real por carga",
    text: "Define la capacidad necesaria considerando el peso total de la tarima, producto o contenedor."
  },
  {
    title: "Frecuencia diaria de pesaje",
    text: "No es lo mismo pesar algunas veces al día que operar durante varios turnos."
  },
  {
    title: "Ingreso con patín o montacargas",
    text: "El tipo de acceso influye en la estructura, resistencia y dimensiones de la plataforma."
  },
  {
    title: "Ambiente de trabajo",
    text: "Considerar humedad, lavado, polvo, corrosión, temperatura o limpieza frecuente."
  },
  {
    title: "Necesidad de tickets o control digital",
    text: "Definir si se requiere indicador básico, impresión, reportes, usuarios o integración."
  }
];

const guideCards = [
  {
    label: "Uso moderado",
    title: "Quiero una opción funcional para almacén",
    text: "Empieza por la línea Base si el uso será moderado, en interior y con cargas controladas.",
    href: "/basculas/bajo-perfil/base/",
    cta: "Ver línea Base"
  },
  {
    label: "Flujo diario",
    title: "Peso todos los días en recibo o embarques",
    text: "La línea Comercial suele ser el punto medio para flujo diario, almacén y operación con tarimas.",
    href: "/basculas/bajo-perfil/comercial/",
    cta: "Ver línea Comercial"
  },
  {
    label: "Trabajo pesado",
    title: "Tengo uso pesado o turnos largos",
    text: "La línea Industrial es mejor cuando hay tráfico constante, carga pesada y necesidad de continuidad.",
    href: "/basculas/bajo-perfil/industrial/",
    cta: "Ver línea Industrial"
  },
  {
    label: "Control digital",
    title: "Necesito tickets, registros o integración",
    text: "La línea Pro permite configurar indicadores, periféricos y opciones de control documental.",
    href: "/basculas/bajo-perfil/pro/",
    cta: "Ver línea Pro"
  },
  {
    label: "Ambiente sanitario",
    title: "Hay humedad, lavado o proceso sanitario",
    text: "La línea Inoxidable es la ruta correcta cuando el ambiente exige resistencia y limpieza frecuente.",
    href: "/basculas/bajo-perfil/inoxidable/",
    cta: "Ver línea Inoxidable"
  }
];

const technicalSummaryCards = [
  {
    slug: "base",
    name: "Base",
    application: "Entrada funcional para almacén",
    text: "Recomendada para operación sencilla, carga controlada y procesos de almacén que necesitan una solución práctica.",
    recommendation: "Conviene Base si buscas una solución sencilla para almacén, recibo o carga controlada."
  },
  {
    slug: "comercial",
    name: "Comercial",
    application: "Uso diario con varias medidas",
    text: "Buena opción para flujo diario, recibo, embarques y operaciones que necesitan más flexibilidad de medidas.",
    recommendation: "Conviene Comercial si necesitas uso diario, varias medidas y una buena relación costo-beneficio."
  },
  {
    slug: "industrial",
    name: "Industrial",
    application: "Mayor resistencia para operación continua",
    text: "Pensada para trabajo exigente, uso frecuente y operaciones donde la instalación requiere mayor robustez.",
    recommendation: "Conviene Industrial si tendrás uso frecuente, carga pesada o instalación más exigente."
  },
  {
    slug: "pro",
    name: "Industrial Pro",
    application: "Mayor capacidad y configuración robusta",
    text: "Adecuada cuando se requiere mayor capacidad, configuración robusta y componentes pensados para control operativo.",
    recommendation: "Conviene Industrial Pro si necesitas mayor capacidad, cable blindado y configuración más robusta."
  },
  {
    slug: "inoxidable",
    name: "Inoxidable",
    application: "Para humedad, lavado o proceso sanitario",
    text: "Diseñada para ambientes con humedad, limpieza frecuente, corrosión o exigencias de proceso sanitario.",
    recommendation: "Conviene Inoxidable si el ambiente exige resistencia a humedad, lavado o proceso sanitario."
  }
] as const;

const technicalComparisonRows = [
  {
    label: "Medidas disponibles",
    values: {
      base: "120 × 120 cm",
      comercial: "90 × 90 / 120 × 120 / 150 × 150 cm",
      industrial: "90 × 90 / 120 × 120 / 150 × 150 cm",
      pro: "100 × 100 / 120 × 120 / 150 × 150 cm",
      inoxidable: "100 × 100 / 120 × 120 / 150 × 150 cm"
    }
  },
  {
    label: "Capacidades",
    values: {
      base: "1,500 kg",
      comercial: "1,000 / 2,000 / 3,000 kg",
      industrial: "1,000 / 2,000 / 3,000 kg",
      pro: "1,200 / 3,000 / 4,000 kg",
      inoxidable: "1,000 / 2,000 / 3,000 kg"
    }
  },
  {
    label: "Material",
    values: {
      base: "Acero al carbón",
      comercial: "Acero al carbón",
      industrial: "Acero al carbón de uso industrial",
      pro: "Acero al carbón de uso industrial",
      inoxidable: "Acero inoxidable"
    }
  },
  {
    label: "Indicador de peso",
    values: {
      base: "Línea comercial, solo peso",
      comercial: "Línea comercial",
      industrial: "Línea industrial en plástico ABS",
      pro: "Línea industrial en plástico ABS",
      inoxidable: "Línea industrial en acero inoxidable"
    }
  },
  {
    label: "Alimentación",
    values: {
      base: "Cargador",
      comercial: "Cargador",
      industrial: "Según configuración",
      pro: "Cable",
      inoxidable: "Cargador"
    }
  },
  {
    label: "Cable",
    values: {
      base: "Cable estándar de 5 m",
      comercial: "Cable estándar de 5 m",
      industrial: "Según configuración",
      pro: "Cable blindado de 5 m",
      inoxidable: "Cable de 5 m"
    }
  },
  {
    label: "Rampas",
    values: {
      base: "Compatible con rampas",
      comercial: "Compatible con rampas",
      industrial: "Compatible con rampas",
      pro: "Compatible con rampas",
      inoxidable: "Compatible con rampas"
    }
  },
  {
    label: "Instalación en fosa",
    values: {
      base: "No recomendada para fosa",
      comercial: "Compatible con instalación en fosa",
      industrial: "Compatible con instalación en fosa",
      pro: "Compatible con instalación en fosa",
      inoxidable: "Compatible con instalación en fosa"
    }
  },
  {
    label: "Sensores / celdas",
    values: {
      base: "Celdas en acero al carbón",
      comercial: "Celdas en acero al carbón",
      industrial: "Celdas en acero al carbón",
      pro: "Celdas en acero al carbón",
      inoxidable: "Sensores en acero inoxidable"
    }
  }
] as const;

const directComparisonRows = [
  ...technicalComparisonRows,
  {
    label: "Mejor escenario de uso",
    values: {
      base: "Almacén, recibo y operación moderada",
      comercial: "Uso diario, recibo y embarques",
      industrial: "Uso frecuente, carga pesada o instalación exigente",
      pro: "Mayor capacidad, control y configuración robusta",
      inoxidable: "Humedad, lavado o proceso sanitario"
    }
  }
] as const;

const comparisonRecommendations: Record<string, string> = {
  "base|comercial":
    "La línea Base conviene para operación sencilla y carga controlada. La línea Comercial es mejor si necesitas más medidas, mayor rango de capacidad y uso diario.",
  "base|industrial":
    "La línea Base funciona para almacén y operación moderada. La línea Industrial conviene cuando hay mayor exigencia, uso frecuente o instalación en fosa.",
  "comercial|pro":
    "La línea Comercial cubre operación diaria con buena relación costo-beneficio. La Industrial Pro conviene cuando necesitas mayor capacidad, cable blindado y configuración más robusta.",
  "pro|inoxidable":
    "Industrial Pro es mejor para capacidad y configuración robusta. Inoxidable conviene cuando el ambiente exige resistencia a humedad, lavado o proceso sanitario."
};

const quickComparisonData = {
  lines: Object.fromEntries(
    technicalSummaryCards.map((line) => [
      line.slug,
      {
        name: line.name,
        application: line.application,
        recommendation: line.recommendation
      }
    ])
  ),
  rows: directComparisonRows,
  recommendations: comparisonRecommendations
};

const specialConfigPoints = [
  "Plataforma en acero al carbón o acero inoxidable",
  "Indicador digital comercial o industrial",
  "Configuraciones para áreas secas, húmedas o de mayor exigencia",
  "Selección de capacidad y medidas según la operación",
  "Recomendación técnica antes de cotizar"
];

const selectionCards: Array<{
  slug: LowProfileLine["slug"];
  eyebrow: string;
  title: string;
  text: string;
  chips: string[];
  cta: string;
  image?: string;
}> = [
  {
    slug: "base",
    eyebrow: "Entrada confiable",
    title: "Báscula de Bajo Perfil Base",
    text: "Para operaciones moderadas que buscan una solución funcional, accesible y confiable para almacén, recibo o embarques ligeros.",
    chips: ["Almacén", "Recibo", "Embarques ligeros"],
    cta: "Ver línea Base",
    image: "base"
  },
  {
    slug: "comercial",
    eyebrow: "Operación diaria",
    title: "Báscula de Bajo Perfil Comercial",
    text: "Equilibra costo, robustez y facilidad de uso para comercio mayorista, centros de distribución y áreas de embarque.",
    chips: ["Comercio mayorista", "CEDIS", "Almacén"],
    cta: "Ver línea Comercial",
    image: "comercial"
  },
  {
    slug: "industrial",
    eyebrow: "Trabajo pesado",
    title: "Báscula de Bajo Perfil Industrial",
    text: "Recomendada para uso intenso, turnos largos, movimientos frecuentes y operación con patín o montacargas.",
    chips: ["Producción", "Logística", "Industria"],
    cta: "Ver línea Industrial",
    image: "industrial"
  },
  {
    slug: "pro",
    eyebrow: "Mayor configuración",
    title: "Báscula de Bajo Perfil Pro",
    text: "Ideal cuando el pesaje requiere reportes, tickets, control de entradas y salidas, usuarios o documentación operativa.",
    chips: ["Control operativo", "Trazabilidad", "Reportes"],
    cta: "Ver línea Pro",
    image: "industrial_pro"
  },
  {
    slug: "inoxidable",
    eyebrow: "Industria alimenticia",
    title: "Báscula de Bajo Perfil Inoxidable",
    text: "Recomendada para ambientes con humedad, limpieza frecuente, corrosión o mayores exigencias sanitarias.",
    chips: ["Alimentos", "Humedad", "Lavado"],
    cta: "Ver línea Inoxidable",
    image: "inoxidable"
  }
];

const lineHref = (slug: LowProfileLine["slug"]) => withBase(`/basculas/bajo-perfil/${slug}/`);
---

<article class="lp-page">
  {view === "landing" && (
    <>
      <section
        class="lp-hero lp-hero--background"
        aria-labelledby="lp-hero-title"
        style={`--lp-hero-image: url("${withBase("/plataforma_2.webp")}")`}
      >
        <div class="lp-hero__inner">
          <div class="lp-hero__content">
            <p class="eyebrow">Básculas de bajo perfil</p>
            <h1 id="lp-hero-title">Básculas de piso para uso industrial y comercial</h1>
            <p class="lead">
              Plataformas de bajo perfil diseñadas para pesar tarimas, mercancía, materia prima,
              insumos y producto terminado de forma práctica, cómoda y confiable.
            </p>
            <p>
              Te ayudamos a elegir la opción más conveniente según capacidad, frecuencia de uso,
              tipo de carga, condiciones del área y necesidades de tu negocio.
            </p>
            <div class="button-row">
              <a class="button" href={whatsappHref} target="_blank" rel="noreferrer">
                Cotizar por WhatsApp
              </a>
              <a class="button secondary" href={quoteAnchor}>Solicitar asesoría</a>
            </div>
            <div class="lp-hero__proof" aria-label="Beneficios principales">
              {quickMetrics.map((item) => <span>{item}</span>)}
            </div>
          </div>

          <span class="lp-hero__visual" aria-hidden="true"></span>
        </div>
      </section>

      <section class="section lp-lines lp-lines--selector" aria-labelledby="lp-lines-title">
        <div class="section-inner lp-split-heading">
          <div>
            <p class="eyebrow">Líneas disponibles</p>
            <h2 id="lp-lines-title">Elige por operación, no solo por precio</h2>
          </div>
          <p>
            La báscula correcta depende del flujo de trabajo, el ambiente de operación, la
            frecuencia de uso y el nivel de control que necesita tu empresa.
          </p>
        </div>
        <div class="section-inner lp-line-grid">
          {selectionCards.map((card) => (
            <article class={`lp-line-card lp-line-card--${card.slug}`}>
              <div class="lp-line-card__content">
                <div class="lp-line-card__top">
                  <span class="lp-line-card__icon" aria-hidden="true">
                    {
                      card.slug === "base" ? (
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M4 9h16v8H4z" />
                          <path d="M7 17v2" />
                          <path d="M17 17v2" />
                        </svg>
                      ) : card.slug === "comercial" ? (
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M3 7h18" />
                          <path d="M6 7v12" />
                          <path d="M18 7v12" />
                          <path d="M4 13h16" />
                        </svg>
                      ) : card.slug === "industrial" ? (
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M5 18h14" />
                          <path d="M7 18V8l5-3 5 3v10" />
                          <path d="M10 18v-6h4v6" />
                        </svg>
                      ) : card.slug === "pro" ? (
                        <svg viewBox="0 0 24 24" fill="none">
                          <rect x="5" y="4" width="14" height="16" rx="2" />
                          <path d="M8 8h8" />
                          <path d="M8 12h3" />
                          <path d="M13 12h3" />
                          <path d="M8 16h8" />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M12 3v18" />
                          <path d="M5 8h14" />
                          <path d="M7 16h10" />
                        </svg>
                      )
                    }
                  </span>
                  <span class="lp-line-card__eyebrow">{card.eyebrow}</span>
                </div>
                <h3>{card.title}</h3>
                <p>{card.text}</p>
                <div class="lp-line-card__tags" aria-label={`Aplicaciones de ${card.title}`}>
                  {card.chips.map((item) => <small>{item}</small>)}
                </div>
                <a class="lp-line-card__cta" href={lineHref(card.slug)}>{card.cta} <span aria-hidden="true">→</span></a>
              </div>
              <div class="lp-line-card__visual" aria-hidden="true">
                {card.image ? (
                  <img
                    src={withBase(`/Bajo-Perfil/${card.image}.webp`)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span></span>
                )}
              </div>
            </article>
          ))}
        </div>
        <div class="section-inner lp-line-help">
          <div>
            <h3>¿No sabes qué línea elegir?</h3>
            <p>
              Te ayudamos a seleccionar la báscula correcta según capacidad, medidas, ambiente de
              trabajo y tipo de operación.
            </p>
          </div>
          <a href={quoteAnchor}>Solicitar asesoría <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="section lp-applications lp-decision-flow">
        <div class="section-inner lp-decision-heading">
          <div>
            <p class="eyebrow">Aplicaciones</p>
            <h2>Pesaje de piso para operaciones reales de trabajo</h2>
          </div>
          <p>
            Las básculas de bajo perfil ayudan cuando la carga debe pesarse rápido, sin fosa, con
            acceso sencillo y lectura clara para el operador.
          </p>
        </div>
        <div class="section-inner lp-application-grid">
          {applicationCards.map((item, index) => (
            <article>
              <span class="lp-card-icon" aria-hidden="true">
                {index % 4 === 0 && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 20V8l8-4 8 4v12" />
                    <path d="M8 20v-8h8v8" />
                    <path d="M4 20h16" />
                  </svg>
                )}
                {index % 4 === 1 && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 17h18" />
                    <path d="M6 17V7h12v10" />
                    <path d="M8 10h8" />
                    <path d="M8 13h8" />
                  </svg>
                )}
                {index % 4 === 2 && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 19h14" />
                    <path d="M7 19V6h10v13" />
                    <path d="M9 9h6" />
                    <path d="M9 13h6" />
                  </svg>
                )}
                {index % 4 === 3 && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 7h11v10H4z" />
                    <path d="M15 10h3l2 3v4h-5" />
                    <path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                    <path d="M18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                  </svg>
                )}
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section lp-selection lp-decision-flow" id="seleccion-bajo-perfil">
        <div class="section-inner lp-decision-heading">
          <div>
            <p class="eyebrow">Selección técnica</p>
            <h2>Antes de cotizar, revisa estos 5 datos</h2>
          </div>
          <p>
            Con esta información podemos recomendar una línea adecuada, evitar sobredimensionar el
            equipo y reducir errores por ambiente, carga o frecuencia de uso.
          </p>
        </div>
        <div class="section-inner lp-factor-grid">
          {selectionChecklist.map((factor, index) => (
            <article>
              <div class="lp-factor-card__top">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <i class="lp-card-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 12h14" />
                    <path d="M7 8h10" />
                    <path d="M9 16h6" />
                  </svg>
                </i>
              </div>
              <h3>{factor.title}</h3>
              <p>{factor.text}</p>
            </article>
          ))}
        </div>
        <div class="section-inner lp-inline-cta lp-selection-cta">
          <p>¿No tienes estos datos claros? Podemos ayudarte a definirlos con unas preguntas.</p>
          <button
            class="button"
            type="button"
            data-disclosure-trigger
            data-target="guia-bajo-perfil"
            data-open-label="Abrir guía de selección →"
            data-close-label="Ocultar guía de selección"
            aria-controls="guia-bajo-perfil"
            aria-expanded="false"
          >
            Abrir guía de selección →
          </button>
        </div>
        <div
          class="section-inner lp-disclosure-panel lp-guide-panel"
          id="guia-bajo-perfil"
          data-disclosure-panel
          hidden
        >
          <div class="lp-disclosure-heading">
            <p class="eyebrow">Guía rápida</p>
            <h3>Elige el escenario que más se parece a tu operación</h3>
            <p>
              Esta guía te ayuda a reducir opciones sin salir de la página. La recomendación final
