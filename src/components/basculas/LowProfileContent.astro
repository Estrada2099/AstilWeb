                    ) : index === 2 ? (
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 3v18" />
                        <path d="M5 8h14" />
                        <path d="M7 16h10" />
                      </svg>
                    ) : index === 3 ? (
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 6h16" />
                        <path d="M7 6v12" />
                        <path d="M17 6v12" />
                        <path d="M4 18h16" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 3l7 4v5c0 4.5-2.8 7.8-7 9-4.2-1.2-7-4.5-7-9V7l7-4z" />
                        <path d="M8.5 12.2l2.2 2.2 4.8-5" />
                      </svg>
                    )
                  }
                </span>
                <strong>{point}</strong>
              </div>
            ))}
          </aside>
        </div>
      </section>

      <section class="section lp-faq-section">
        <div class="section-inner lp-split-heading">
          <div>
            <p class="eyebrow">Preguntas frecuentes</p>
            <h2>FAQ sobre básculas de bajo perfil</h2>
          </div>
          <p>Respuestas rápidas antes de cotizar una báscula de piso para tarimas.</p>
        </div>
        <div class="section-inner lp-faq-list">
          {lowProfileFaqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </>
  )}
</article>

<script type="application/json" id="lp-comparison-data" set:html={JSON.stringify(quickComparisonData)} />

<script>
  const forms = document.querySelectorAll("[data-low-profile-form]");
  const modal = document.querySelector("[data-low-profile-success]");
  const nameTarget = document.querySelector("[data-low-profile-name]");
  const closeButtons = document.querySelectorAll("[data-low-profile-close]");

  const openModal = (name: string) => {
    if (!(modal instanceof HTMLElement)) return;
    if (nameTarget instanceof HTMLElement) {
      nameTarget.textContent = name ? `, ${name}` : "";
    }
    modal.hidden = false;
    document.body.classList.add("modal-open");
    modal.querySelector("button")?.focus();
  };

  const closeModal = () => {
    if (!(modal instanceof HTMLElement)) return;
    modal.hidden = true;
    document.body.classList.remove("modal-open");
  };

  closeButtons.forEach((button) => button.addEventListener("click", closeModal));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeModal();
  });

  const comparisonSource = document.getElementById("lp-comparison-data");
  const comparisonData =
    comparisonSource?.textContent ? JSON.parse(comparisonSource.textContent) : null;

  const getRecommendationKey = (a: string, b: string) => [a, b].sort().join("|");

  const setDisclosureTriggerState = (targetId: string, isOpen: boolean) => {
    document.querySelectorAll(`[data-disclosure-trigger][data-target="${targetId}"]`).forEach((item) => {
      if (!(item instanceof HTMLButtonElement)) return;
      item.setAttribute("aria-expanded", String(isOpen));
      item.textContent = isOpen
        ? item.dataset.closeLabel || "Ocultar"
        : item.dataset.openLabel || "Abrir";
    });
  };

  const renderLineComparator = (comparator: Element) => {
    if (!comparisonData) return;

    const selectA = comparator.querySelector("[data-compare-select='a']");
    const selectB = comparator.querySelector("[data-compare-select='b']");
    if (!(selectA instanceof HTMLSelectElement) || !(selectB instanceof HTMLSelectElement)) return;

    const slugs = Object.keys(comparisonData.lines);
    const ensureDifferent = (changed: HTMLSelectElement) => {
      if (selectA.value !== selectB.value) return;
      const fallback = slugs.find((slug) => slug !== changed.value);
      if (!fallback) return;
      if (changed === selectA) selectB.value = fallback;
      else selectA.value = fallback;
    };

    const render = () => {
      const slugA = selectA.value;
      const slugB = selectB.value;
      const lineA = comparisonData.lines[slugA];
      const lineB = comparisonData.lines[slugB];
      if (!lineA || !lineB) return;

      const title = comparator.querySelector("[data-compare-title]");
      if (title instanceof HTMLElement) title.textContent = `${lineA.name} vs ${lineB.name}`;

      comparator.querySelectorAll("[data-compare-row]").forEach((row, index) => {
        if (!(row instanceof HTMLElement)) return;
        const factor = comparisonData.rows[index];
        if (!factor) return;

        const valueA = factor.values[slugA] || "";
        const valueB = factor.values[slugB] || "";
        row.classList.toggle("is-different", valueA !== valueB);

        const labelA = row.querySelector("[data-compare-line='a']");
        const labelB = row.querySelector("[data-compare-line='b']");
        const outputA = row.querySelector("[data-compare-value='a']");
        const outputB = row.querySelector("[data-compare-value='b']");
        if (labelA instanceof HTMLElement) labelA.textContent = lineA.name;
        if (labelB instanceof HTMLElement) labelB.textContent = lineB.name;
        if (outputA instanceof HTMLElement) outputA.textContent = valueA;
        if (outputB instanceof HTMLElement) outputB.textContent = valueB;
      });

      const recommendation = comparator.querySelector("[data-compare-recommendation]");
      const recommendationText =
        comparisonData.recommendations[getRecommendationKey(slugA, slugB)] ||
        `${lineA.recommendation} ${lineB.recommendation}`;
      if (recommendation instanceof HTMLElement) recommendation.textContent = recommendationText;
    };

    selectA.addEventListener("change", () => {
      ensureDifferent(selectA);
      render();
    });
    selectB.addEventListener("change", () => {
      ensureDifferent(selectB);
      render();
    });
    render();
  };

  document.querySelectorAll("[data-line-comparator]").forEach(renderLineComparator);

  document.querySelectorAll("[data-compare-preset]").forEach((trigger) => {
    if (!(trigger instanceof HTMLAnchorElement)) return;

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      const slug = trigger.dataset.comparePreset;
      const comparator = document.querySelector("[data-line-comparator]");
      const selectA = comparator?.querySelector("[data-compare-select='a']");
      const selectB = comparator?.querySelector("[data-compare-select='b']");
      if (!slug || !(selectA instanceof HTMLSelectElement) || !(selectB instanceof HTMLSelectElement)) return;

      if (comparator instanceof HTMLElement) {
        comparator.hidden = false;
        setDisclosureTriggerState("comparador-rapido", true);

        const table = document.getElementById("matriz-tecnica-completa");
        if (table instanceof HTMLElement) {
          table.hidden = true;
          setDisclosureTriggerState("matriz-tecnica-completa", false);
        }
      }

      selectA.value = slug;
      if (selectB.value === slug) {
        const option = Array.from(selectB.options).find((item) => item.value !== slug);
        if (option) selectB.value = option.value;
      }
      selectA.dispatchEvent(new Event("change", { bubbles: true }));
      comparator?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  document.querySelectorAll("[data-disclosure-trigger]").forEach((trigger) => {
    if (!(trigger instanceof HTMLButtonElement)) return;

    trigger.addEventListener("click", () => {
      const targetId = trigger.dataset.target;
      if (!targetId) return;

      const panel = document.getElementById(targetId);
      if (!(panel instanceof HTMLElement)) return;

      const willOpen = panel.hidden;
      const hideTargetId = trigger.dataset.hideTarget;
      if (willOpen && hideTargetId) {
        const hidePanel = document.getElementById(hideTargetId);
        if (hidePanel instanceof HTMLElement) {
          hidePanel.hidden = true;
          setDisclosureTriggerState(hideTargetId, false);
        }
      }

      panel.hidden = !willOpen;
      setDisclosureTriggerState(targetId, willOpen);

      if (willOpen) {
        panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });
  });

  forms.forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    const status = form.querySelector("[data-low-profile-status]");
    const submitButton = form.querySelector("button[type='submit']");
    const defaultButtonText = submitButton?.textContent ?? "Enviar solicitud";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(submitButton instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

      status.textContent = "";
      status.className = "lp-form-status";
      submitButton.disabled = true;
      submitButton.textContent = "Enviando...";

      try {
        const formData = new FormData(form);
        const nombre = String(formData.get("nombre") ?? "").trim();
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json"
          }
        });

        if (!response.ok) throw new Error("No se pudo enviar el formulario");

        form.reset();
        openModal(nombre);
      } catch {
        status.textContent =
          "No pudimos enviar la solicitud. Intenta de nuevo o contáctanos por WhatsApp.";
        status.classList.add("is-error");
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = defaultButtonText;
      }
    });
  });
</script>

