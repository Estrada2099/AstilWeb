---
import SmartImage from "../SmartImage.astro";
import { contact } from "../../data/site";
import {
  getLowProfileLine,
  lowProfileApplications,
  lowProfileComparisonRows,
  lowProfileDecisionPaths,
  lowProfileFaqs,
  lowProfileLines,
  type LowProfileLine
} from "../../data/lowProfileScales";

interface Props {
  view: "landing" | "product" | "comparator" | "guide";
  productSlug?: LowProfileLine["slug"];
}

const { view, productSlug } = Astro.props;
const currentLine = productSlug ? getLowProfileLine(productSlug) : undefined;
if (view === "product" && !currentLine) {
  throw new Error(`No existe la línea de bajo perfil: ${productSlug}`);
}

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const quoteAnchor = "#cotizar-bajo-perfil";
const comparatorHref = withBase("/basculas/bajo-perfil/comparador/");
const guideHref = withBase("/basculas/bajo-perfil/que-bascula-necesito/");
const landingHref = withBase("/basculas/bajo-perfil/");
const selectedLine = currentLine ?? lowProfileLines[2];
const whatsappMessage = encodeURIComponent(
  currentLine?.whatsappIntent ??
    "Hola, quiero cotizar una báscula de bajo perfil. Necesito asesoría para elegir capacidad, medidas y línea adecuada."
);
const whatsappHref = `${contact.whatsapp[0].href}?text=${whatsappMessage}`;
const contactSubject =
  view === "product"
    ? `Solicitud ${selectedLine.name}`
    : view === "comparator"
      ? "Solicitud desde comparador de básculas de bajo perfil"
      : view === "guide"
        ? "Solicitud desde guía de selección de báscula de bajo perfil"
        : "Solicitud desde landing de básculas de bajo perfil";
const formIntro =
  view === "guide"
    ? "Comparte cómo será la operación y te ayudamos a definir línea, capacidad y configuración."
    : view === "comparator"
      ? "Si ya tienes dos opciones en mente, envíanos los datos de operación y te ayudamos a cerrar la decisión."
      : "Cuéntanos qué necesitas pesar y te orientamos con una recomendación clara.";

const quickMetrics = [
  "Instalación sin obra civil en la mayoría de casos",
  "Rampa para patín o carga rodada",
  "Configuración por capacidad, medidas y ambiente"
];

const selectionFactors = [
  "Peso máximo real por tarima o carga",
  "Frecuencia diaria de pesaje",
  "Ingreso con patín, carro o montacargas",
  "Ambiente seco, húmedo, lavado o polvo",
  "Necesidad de tickets, reportes o control digital"
];

const specialConfigPoints = [
  "Plataforma en acero al carbón o acero inoxidable",
  "Indicador digital comercial o industrial",
  "Configuraciones para áreas secas, húmedas o de mayor exigencia",
  "Selección de capacidad y medidas según la operación",
  "Recomendación técnica antes de cotizar"
];

const lineHref = (slug: LowProfileLine["slug"]) => withBase(`/basculas/bajo-perfil/${slug}/`);
const valueFor = (line: LowProfileLine, key: (typeof lowProfileComparisonRows)[number]["key"]) => {
  const value = line[key];
  return Array.isArray(value) ? value.join(", ") : value;
};
---

<article class="lp-page">
  {view === "landing" && (
    <>
      <section class="lp-hero" aria-labelledby="lp-hero-title">
        <div class="lp-hero__inner">
          <div class="lp-hero__content">
            <p class="eyebrow">Básculas de bajo perfil</p>
            <h1 id="lp-hero-title">Básculas de piso para tarimas, almacén e industria</h1>
            <p class="lead">
              Plataformas de bajo perfil para pesar mercancía, tarimas, materia prima y producto
              terminado con acceso cómodo, lectura confiable y asesoría técnica desde la selección.
            </p>
            <p>
              Te ayudamos a elegir la línea adecuada según capacidad, frecuencia de uso, ambiente,
              tipo de carga y nivel de control que necesita tu operación.
            </p>
            <div class="button-row">
              <a class="button" href={whatsappHref} target="_blank" rel="noreferrer">
                Cotizar por WhatsApp
              </a>
              <a class="button secondary" href={quoteAnchor}>Solicitar asesoría</a>
            </div>
            <div class="lp-hero__proof" aria-label="Beneficios principales">
              {quickMetrics.map((item) => <span>{item}</span>)}
            </div>
          </div>

          <aside class="lp-hero__visual" aria-label="Báscula de bajo perfil para tarimas">
            <SmartImage
              name="Pexisa/PlataformasPiso"
              alt="Báscula de bajo perfil para tarimas y pesaje industrial de piso"
              loading="eager"
              decoding="async"
            />
          </aside>
        </div>
      </section>

      <nav class="lp-line-nav" aria-label="Líneas de básculas de bajo perfil">
        <a href={landingHref}>General</a>
        {lowProfileLines.map((line) => <a href={lineHref(line.slug)}>{line.shortName}</a>)}
        <a href="#comparador-bajo-perfil">Comparador</a>
        <a href="#seleccion-bajo-perfil">¿Qué báscula necesito?</a>
      </nav>

      <section class="section lp-lines" aria-labelledby="lp-lines-title">
        <div class="section-inner lp-split-heading">
          <div>
            <p class="eyebrow">Líneas disponibles</p>
            <h2 id="lp-lines-title">Elige por operación, no solo por precio</h2>
          </div>
          <p>
            Una báscula de piso correcta reduce retrabajos, reclamos por diferencias de peso y
            compras que se quedan cortas al primer cambio de operación.
          </p>
        </div>
        <div class="section-inner lp-line-grid">
          {lowProfileLines.map((line) => (
            <article class="lp-line-card">
              <span>{line.eyebrow}</span>
              <h3>{line.name}</h3>
              <p>{line.summary}</p>
              <div class="lp-line-card__tags" aria-label={`Usos recomendados para ${line.name}`}>
                {line.bestFor.slice(0, 3).map((item) => <small>{item}</small>)}
              </div>
              <a href={lineHref(line.slug)}>Ver línea {line.shortName}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section lp-applications">
        <div class="section-inner lp-app-grid">
          <div>
            <p class="eyebrow">Aplicaciones</p>
            <h2>Pesaje de piso para flujo real de trabajo</h2>
            <p>
              Las básculas de bajo perfil funcionan bien cuando la carga debe entrar rápido a la
              plataforma, sin fosa, sin maniobras complejas y con operadores que necesitan una
              lectura clara.
            </p>
          </div>
          <div class="lp-chip-grid">
            {lowProfileApplications.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </section>

      <section class="section lp-selection" id="seleccion-bajo-perfil">
        <div class="section-inner lp-split-heading">
          <div>
            <p class="eyebrow">Selección técnica</p>
            <h2>Antes de cotizar conviene revisar cinco datos</h2>
          </div>
          <p>
            Con esta información podemos evitar sobredimensionar el equipo o recomendar una línea
            que no aguante el ambiente de trabajo.
          </p>
        </div>
        <div class="section-inner lp-factor-grid">
          {selectionFactors.map((factor, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{factor}</h3>
            </article>
          ))}
        </div>
        <div class="section-inner lp-inline-cta">
          <p>Si no tienes esos datos claros, podemos ayudarte a definirlos con unas preguntas.</p>
          <button
            class="button"
            type="button"
            data-disclosure-trigger
            data-target="guia-bajo-perfil"
            data-open-label="Abrir guía de selección"
            data-close-label="Ocultar guía de selección"
            aria-controls="guia-bajo-perfil"
            aria-expanded="false"
          >
            Abrir guía de selección
          </button>
        </div>
        <div
          class="section-inner lp-disclosure-panel lp-guide-panel"
          id="guia-bajo-perfil"
          data-disclosure-panel
          hidden
        >
          <div class="lp-disclosure-heading">
            <p class="eyebrow">Guía rápida</p>
            <h3>Elige el escenario que más se parece a tu operación</h3>
            <p>
              Esta guía reduce opciones sin obligarte a salir de la página. La recomendación final
              depende de capacidad, ambiente y viabilidad técnica.
            </p>
          </div>
          <div class="lp-decision-grid">
            {lowProfileDecisionPaths.map((path) => (
              <article>
                <h3>{path.title}</h3>
                <p>{path.text}</p>
                <a href={withBase(path.href)}>{path.label}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section lp-compare-preview" id="comparador-bajo-perfil">
        <div class="section-inner lp-split-heading">
          <div>
            <p class="eyebrow">Comparador</p>
            <h2>Compara Base, Comercial, Industrial, Pro e Inoxidable</h2>
          </div>
          <p>
            Revisa de un vistazo qué línea conviene según ambiente, capacidad, nivel de inversión y
            exigencia operativa.
          </p>
        </div>
        <div class="section-inner lp-mini-compare">
          {lowProfileLines.map((line) => (
            <a href={lineHref(line.slug)}>
              <strong>{line.shortName}</strong>
              <span>{line.strength}</span>
            </a>
          ))}
        </div>
        <div class="section-inner lp-inline-cta">
          <p>También puedes revisar la matriz completa para tomar una decisión más rápida.</p>
          <button
            class="button secondary"
            type="button"
            data-disclosure-trigger
            data-target="comparador-matriz"
            data-open-label="Ver comparador"
            data-close-label="Ocultar comparador"
            aria-controls="comparador-matriz"
            aria-expanded="false"
          >
            Ver comparador
          </button>
        </div>
        <div
          class="section-inner lp-disclosure-panel lp-table-wrap"
          id="comparador-matriz"
          data-disclosure-panel
          hidden
          tabindex="0"
          aria-label="Tabla comparativa de básculas de bajo perfil"
        >
          <table class="lp-comparison-table">
            <thead>
              <tr>
                <th>Factor</th>
                {lowProfileLines.map((line) => <th>{line.shortName}</th>)}
              </tr>
            </thead>
            <tbody>
              {lowProfileComparisonRows.map((row) => (
                <tr>
                  <th>{row.label}</th>
                  {lowProfileLines.map((line) => <td>{valueFor(line, row.key)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}

  {view === "product" && currentLine && (
    <>
      <section class="lp-hero lp-hero--product" aria-labelledby="lp-product-title">
        <div class="lp-hero__inner">
          <div class="lp-hero__content">
            <p class="eyebrow">{currentLine.eyebrow}</p>
            <h1 id="lp-product-title">{currentLine.headline}</h1>
            <p class="lead">{currentLine.subheadline}</p>
            <p>{currentLine.summary}</p>
            <div class="button-row">
              <a class="button" href={whatsappHref} target="_blank" rel="noreferrer">
                Cotizar {currentLine.shortName}
              </a>
              <a class="button secondary" href={quoteAnchor}>Solicitar asesoría</a>
            </div>
          </div>

          <aside class="lp-product-panel" aria-label={`Resumen de ${currentLine.name}`}>
            <SmartImage
              name="Pexisa/PlataformasPiso"
              alt={`${currentLine.name} para pesaje de piso`}
              loading="eager"
              decoding="async"
            />
            <dl>
              <div>
                <dt>Capacidades</dt>
                <dd>{currentLine.capacities}</dd>
              </div>
              <div>
                <dt>Ambiente</dt>
                <dd>{currentLine.environment}</dd>
              </div>
              <div>
                <dt>Material</dt>
                <dd>{currentLine.material}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <nav class="lp-line-nav" aria-label="Otras líneas de bajo perfil">
        <a href={landingHref}>General</a>
        {lowProfileLines.map((line) => (
          <a class={line.slug === currentLine.slug ? "is-active" : ""} href={lineHref(line.slug)}>
            {line.shortName}
          </a>
        ))}
        <a href={comparatorHref}>Comparador</a>
      </nav>

      <section class="section lp-product-detail">
        <div class="section-inner lp-product-grid">
          <div>
            <p class="eyebrow">Recomendada para</p>
            <h2>{currentLine.name}</h2>
            <p>
              Esta línea funciona mejor cuando la operación coincide con estos escenarios de uso y
              ambiente. Si tienes dudas entre dos líneas, revisamos tu caso antes de cotizar.
            </p>
            <div class="lp-chip-grid">
              {currentLine.bestFor.map((item) => <span>{item}</span>)}
            </div>
          </div>
          <div class="lp-spec-card">
            <h3>Resumen técnico</h3>
            <dl>
              <div>
                <dt>Plataforma</dt>
                <dd>{currentLine.platform}</dd>
              </div>
              <div>
                <dt>Fortaleza</dt>
                <dd>{currentLine.strength}</dd>
              </div>
              <div>
                <dt>Inversión</dt>
                <dd>{currentLine.investment}</dd>
              </div>
              <div>
                <dt>Respuesta</dt>
                <dd>{currentLine.response}</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section class="section lp-included">
        <div class="section-inner lp-three-column">
          <div>
            <p class="eyebrow">Qué incluye</p>
            <h2>Configuración pensada para operar</h2>
            <ul>
              {currentLine.includes.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow">Aplicaciones</p>
            <h2>Casos de uso habituales</h2>
            <ul>
              {currentLine.applications.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow">Evitar si</p>
            <h2>Cuándo conviene otra línea</h2>
            <ul>
              {currentLine.notIdeal.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section lp-proof-section">
        <div class="section-inner lp-proof-grid">
          <div>
            <p class="eyebrow">Por qué Astil</p>
            <h2>No solo vendemos la plataforma: acompañamos la operación</h2>
            <p>
              Podemos apoyar con instalación, mantenimiento, reparación, calibración y revisión de
              componentes para que el equipo siga siendo útil después de la compra.
            </p>
          </div>
          <ul>
            {currentLine.proofPoints.map((item) => <li>{item}</li>)}
            <li>Atención por WhatsApp, llamada o formulario</li>
          </ul>
        </div>
      </section>

      <section class="section lp-related">
        <div class="section-inner lp-inline-cta">
          <p>¿Quieres comparar esta línea contra las demás antes de decidir?</p>
          <a class="button secondary" href={comparatorHref}>Comparar líneas</a>
          <a class="button" href={guideHref}>Abrir guía</a>
        </div>
      </section>
    </>
  )}

  {view === "comparator" && (
    <>
      <section class="lp-hero lp-hero--compact" aria-labelledby="lp-comparator-title">
        <div class="lp-hero__inner">
          <div class="lp-hero__content">
            <p class="eyebrow">Comparador de líneas</p>
            <h1 id="lp-comparator-title">Compara básculas de bajo perfil antes de cotizar</h1>
            <p class="lead">
              Revisa diferencias entre Base, Comercial, Industrial, Pro e Inoxidable para elegir
              con más claridad según uso, ambiente, capacidad y nivel de control.
            </p>
            <div class="button-row">
              <a class="button" href={quoteAnchor}>Solicitar recomendación</a>
              <a class="button secondary" href={guideHref}>No sé cuál elegir</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section lp-comparator-section">
        <div class="section-inner lp-table-wrap" tabindex="0" aria-label="Tabla comparativa de básculas de bajo perfil">
          <table class="lp-comparison-table">
            <thead>
              <tr>
                <th>Factor</th>
                {lowProfileLines.map((line) => <th>{line.shortName}</th>)}
              </tr>
            </thead>
            <tbody>
              {lowProfileComparisonRows.map((row) => (
                <tr>
                  <th>{row.label}</th>
                  {lowProfileLines.map((line) => <td>{valueFor(line, row.key)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section lp-lines lp-lines--recommendations">
        <div class="section-inner lp-split-heading">
          <div>
            <p class="eyebrow">Recomendación rápida</p>
            <h2>La mejor línea depende del riesgo operativo</h2>
          </div>
          <p>
            Si el equipo trabaja poco, el costo pesa más. Si trabaja todos los días, conviene
            priorizar resistencia, soporte y compatibilidad con el proceso.
          </p>
        </div>
        <div class="section-inner lp-line-grid">
          {lowProfileLines.map((line) => (
            <article class="lp-line-card">
              <span>{line.eyebrow}</span>
              <h3>{line.shortName}</h3>
              <p>{line.summary}</p>
              <a href={lineHref(line.slug)}>Ver detalle</a>
            </article>
          ))}
        </div>
      </section>
    </>
  )}

  {view === "guide" && (
    <>
      <section class="lp-hero lp-hero--compact" aria-labelledby="lp-guide-title">
        <div class="lp-hero__inner">
          <div class="lp-hero__content">
            <p class="eyebrow">Guía de selección</p>
            <h1 id="lp-guide-title">¿Qué báscula de bajo perfil necesito?</h1>
            <p class="lead">
              Responde mentalmente estas preguntas y ubica la línea que más se parece a tu
              operación. Si hay duda, te asesoramos antes de comprar.
            </p>
            <div class="button-row">
              <a class="button" href={quoteAnchor}>Pedir recomendación</a>
              <a class="button secondary" href={comparatorHref}>Ver comparador</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section lp-guide-section">
        <div class="section-inner lp-split-heading">
          <div>
            <p class="eyebrow">Rutas de decisión</p>
            <h2>Elige el escenario que más se parece a tu operación</h2>
          </div>
          <p>
            Esta guía no reemplaza una revisión técnica, pero ayuda a reducir opciones y llegar a
            una cotización más precisa.
          </p>
        </div>
        <div class="section-inner lp-decision-grid">
          {lowProfileDecisionPaths.map((path) => (
            <article>
              <h3>{path.title}</h3>
              <p>{path.text}</p>
              <a href={withBase(path.href)}>{path.label}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section lp-selection">
        <div class="section-inner lp-product-grid">
          <div>
            <p class="eyebrow">Checklist para cotizar</p>
            <h2>Datos que aceleran una buena recomendación</h2>
            <p>
              No necesitas tener todo resuelto. Con estos puntos podemos orientar la selección y
              detectar si requieres una configuración especial.
            </p>
          </div>
          <ol class="lp-checklist">
            {selectionFactors.map((factor) => <li>{factor}</li>)}
            <li>Medidas aproximadas de la tarima o carga más grande</li>
            <li>Ubicación de instalación y ciudad</li>
          </ol>
        </div>
      </section>
    </>
  )}

  <section class="section lp-contact-section" id="cotizar-bajo-perfil" aria-labelledby="lp-contact-title">
    <div class="section-inner lp-contact-grid">
      <div class="lp-contact-copy">
        <p class="eyebrow">Cotización y asesoría</p>
        <h2 id="lp-contact-title">Cuéntanos qué necesitas pesar</h2>
        <p>{formIntro}</p>
        <ul>
          <li>Capacidad aproximada y dimensiones de carga</li>
          <li>Uso diario, semanal o por turnos</li>
          <li>Ambiente seco, húmedo, lavado o exterior techado</li>
          <li>Si necesitas rampa, tickets, instalación o calibración</li>
        </ul>
        <div class="lp-direct-contact">
          <a href={whatsappHref} target="_blank" rel="noreferrer">WhatsApp: {contact.whatsapp[0].label}</a>
          <a href={contact.officePhoneHref}>Llamar: {contact.officePhone}</a>
        </div>
      </div>

      <form
        class="lp-contact-form"
        data-low-profile-form
        action="https://formspree.io/f/mojrzejq"
        method="post"
      >
        <input type="hidden" name="_subject" value={contactSubject} />
        <input type="hidden" name="origen" value={contactSubject} />
        <input class="lp-form-honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />

        <div class="lp-form-grid">
          <label>
            Nombre
            <input type="text" name="nombre" autocomplete="name" required />
          </label>
          <label>
            Empresa
            <input type="text" name="empresa" autocomplete="organization" required />
          </label>
          <label>
            Teléfono o WhatsApp
            <input type="tel" name="telefono" autocomplete="tel" required />
          </label>
          <label>
            Correo
            <input type="email" name="email" autocomplete="email" />
          </label>
          <label>
            Línea de interés
            <select name="linea">
              <option value="">No estoy seguro</option>
              {lowProfileLines.map((line) => (
                <option selected={currentLine?.slug === line.slug}>{line.name}</option>
              ))}
            </select>
          </label>
          <label>
            Ubicación
            <input type="text" name="ubicacion" placeholder="Ciudad o zona de instalación" required />
          </label>
        </div>

        <label>
          Describe tu operación
          <textarea
            name="mensaje"
            rows="5"
            placeholder="Ejemplo: tarimas de 1.2 x 1.2 m, hasta 1.5 t, uso diario en almacén con patín hidráulico."
            required
          ></textarea>
        </label>

        <button class="button" type="submit">Enviar solicitud</button>
        <p class="lp-form-status" data-low-profile-status aria-live="polite"></p>
        <p class="lp-form-note">
          También puedes escribir por WhatsApp si necesitas una respuesta rápida o si tienes fotos
          del área donde se instalará la báscula.
        </p>
      </form>
    </div>
  </section>

  <div class="lp-success-modal" data-low-profile-success hidden>
    <div class="lp-success-modal__backdrop" data-low-profile-close></div>
    <div
      class="lp-success-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="lp-success-title"
    >
      <div class="lp-success-modal__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </div>
      <p class="lp-success-modal__eyebrow">Solicitud enviada</p>
