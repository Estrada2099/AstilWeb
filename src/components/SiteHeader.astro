---
import SmartImage from "./SmartImage.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <a class="brand" href={base} aria-label="Astil Básculas">
    <SmartImage name="astil-basculas-logo-horizontal" alt="Astil Básculas" loading="eager" />
  </a>
  <nav class="nav" aria-label="Navegación principal">
    <a href={`${base}#nosotros`}>Nosotros</a>
    <a href={`${base}#servicios`}>Servicios</a>
    <a class="nav-section-cta" href={`${base}#alto-alcance`}>Alto alcance</a>
    <a class="nav-cta" href={`${base}#contacto`}>Contacto</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
    padding: 12px clamp(18px, 5vw, 72px);
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid rgba(215, 221, 229, 0.8);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: min(230px, 52vw);
  }

  .brand :global(picture),
  .brand :global(img) {
    display: block;
    width: 100%;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 700;
  }

  .nav a {
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--red);
  }

  .nav-cta {
    min-height: 38px;
    padding: 9px 14px;
    border-radius: 6px;
    background: var(--ink);
    color: #ffffff;
  }

  .nav-section-cta {
    min-height: 38px;
    padding: 9px 14px;
    border: 1px solid rgba(67, 95, 120, 0.22);
    border-radius: 6px;
    background: #eef4ff;
    color: var(--blue-dark);
  }

  .nav .nav-cta:hover {
    color: #ffffff;
    background: var(--red);
  }

  .nav .nav-section-cta:hover {
    border-color: rgba(212, 33, 46, 0.32);
    background: #ffffff;
    color: var(--red);
  }

  @media (max-width: 760px) {
    .site-header {
      position: static;
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 4px;
      white-space: nowrap;
    }
  }
</style>
