---
import SmartImage from "./SmartImage.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <a class="brand" href={base} aria-label="Astil Básculas">
    <SmartImage name="astil-basculas-logo-horizontal" alt="Astil Básculas" loading="eager" />
  </a>
  <nav class="nav" aria-label="Navegación principal">
    <a href={`${base}#nosotros`}>Nosotros</a>
    <a href={`${base}#servicios`}>Servicios</a>
    <a class="nav-section-cta" href={`${base}basculas/bajo-perfil/`}>Bajo perfil</a>
    <a class="nav-section-cta" href={`${base}#alto-alcance`}>Alto alcance</a>
    <a class="nav-cta" href={`${base}#contacto`}>Contacto</a>
  </nav>
  <div class="mobile-menu">
    <input class="mobile-menu__toggle" id="mobile-menu-toggle" type="checkbox" />
    <label class="mobile-menu__button" for="mobile-menu-toggle" aria-label="Abrir menú de navegación">
      <span></span>
      <span></span>
      <span></span>
    </label>
    <nav aria-label="Navegación móvil">
      <a href={`${base}#nosotros`}>Nosotros</a>
      <a href={`${base}#servicios`}>Servicios</a>
      <a href={`${base}basculas/bajo-perfil/`}>Bajo perfil</a>
      <a href={`${base}#alto-alcance`}>Alto alcance</a>
      <a href={`${base}#contacto`}>Contacto</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
    padding: 12px clamp(18px, 5vw, 72px);
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid rgba(215, 221, 229, 0.8);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: min(230px, 52vw);
  }

  .brand :global(picture),
  .brand :global(img) {
    display: block;
    width: 100%;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 700;
  }

  .nav a {
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--red);
  }

  .nav-cta {
    min-height: 38px;
    padding: 9px 14px;
    border-radius: 6px;
    background: var(--ink);
    color: #ffffff;
  }

  .nav-section-cta {
    min-height: 38px;
    padding: 9px 14px;
    border: 1px solid rgba(67, 95, 120, 0.22);
    border-radius: 6px;
    background: #eef4ff;
    color: var(--blue-dark);
  }

  .nav .nav-cta:hover {
    color: #ffffff;
    background: var(--red);
  }

  .nav .nav-section-cta:hover {
    border-color: rgba(212, 33, 46, 0.32);
    background: #ffffff;
    color: var(--red);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 980px) {
    .site-header {
      position: sticky;
      align-items: center;
      flex-direction: row;
      gap: 16px;
      min-height: 76px;
      padding: 10px 18px;
    }

    .nav {
      display: none;
    }

    .brand {
      width: min(212px, 62vw);
    }

    .mobile-menu {
      position: relative;
      display: block;
      margin-left: auto;
    }

    .mobile-menu__toggle {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .mobile-menu__button {
      display: grid;
      place-items: center;
      width: 46px;
      height: 42px;
      border: 1px solid rgba(67, 95, 120, 0.22);
      border-radius: 8px;
      background: #eef4ff;
      color: var(--blue-dark);
      cursor: pointer;
    }

    .mobile-menu__button span {
      display: block;
      width: 22px;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
      transition:
        transform 180ms ease,
        opacity 180ms ease;
    }

    .mobile-menu__button span + span {
      margin-top: 5px;
    }

    .mobile-menu__toggle:checked + .mobile-menu__button span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .mobile-menu__toggle:checked + .mobile-menu__button span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu__toggle:checked + .mobile-menu__button span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .mobile-menu nav {
      position: absolute;
      top: calc(100% + 12px);
      right: 0;
      display: none;
      width: min(280px, calc(100vw - 36px));
      overflow: hidden;
      border: 1px solid rgba(174, 188, 204, 0.68);
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 20px 50px rgba(8, 17, 28, 0.18);
    }

    .mobile-menu__toggle:checked ~ nav {
      display: grid;
    }

    .mobile-menu nav a {
      padding: 15px 18px;
      color: var(--ink);
      font-weight: 850;
      text-decoration: none;
    }

    .mobile-menu nav a + a {
      border-top: 1px solid rgba(174, 188, 204, 0.46);
    }

    .mobile-menu nav a:hover {
      background: #eef4ff;
      color: var(--blue-dark);
    }
  }
</style>
