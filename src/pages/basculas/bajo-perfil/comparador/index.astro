---
import LowProfileContent from "../../../../components/basculas/LowProfileContent.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Básculas de bajo perfil",
      item: new URL("/basculas/bajo-perfil/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Comparador",
      item: new URL("/basculas/bajo-perfil/comparador/", Astro.site ?? Astro.url).toString()
    }
  ]
};
---

<BaseLayout
  title="Comparador de Básculas de Bajo Perfil | Astil Básculas"
  description="Compara básculas de bajo perfil Base, Comercial, Industrial, Pro e Inoxidable por uso, capacidad, ambiente, material e inversión."
  keywords="comparador de básculas de bajo perfil, comparar básculas de piso, báscula base comercial industrial inoxidable"
  image="/Pexisa/PlataformasPiso.png"
  canonical="/basculas/bajo-perfil/comparador/"
  footerContactHref="#cotizar-bajo-perfil"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <LowProfileContent view="comparator" />
</BaseLayout>
