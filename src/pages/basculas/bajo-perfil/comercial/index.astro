  <script
    is:inline
    define:vars={{
      modelosComerciales,
      whatsappBase: contact.whatsapp[0].href
    }}
  >
    const triggers = document.querySelectorAll("[data-model-trigger]");
    const dynamicWhatsappLinks = document.querySelectorAll("[data-dynamic-whatsapp]");
    const quoteForm = document.querySelector("[data-quote-form]");
    const modelById = new Map(modelosComerciales.map((model) => [model.id, model]));
    let selectedModel = modelosComerciales[1];

    const setText = (selector, value) => {
      document.querySelectorAll(selector).forEach((node) => {
        node.textContent = value;
      });
    };

    const buildWhatsappHref = (message) => `${whatsappBase}?text=${encodeURIComponent(message)}`;

    const updateWhatsapp = () => {
      dynamicWhatsappLinks.forEach((link) => {
        link.setAttribute("href", buildWhatsappHref(selectedModel.whatsapp));
      });
    };

    const selectModel = (id) => {
      const nextModel = modelById.get(id);
      if (!nextModel) return;
      selectedModel = nextModel;

      triggers.forEach((trigger) => {
        const isActive = trigger.getAttribute("data-model-trigger") === id;
        trigger.classList.toggle("is-active", isActive);
        if (trigger.getAttribute("role") === "tab") {
          trigger.setAttribute("aria-selected", String(isActive));
        }
        const status = trigger.querySelector(".model-option__status");
        if (status) status.textContent = isActive ? "Seleccionado" : nextModel.etiqueta;
      });

      setText("[data-model-medida]", selectedModel.medida);
      setText("[data-model-capacidad]", selectedModel.capacidad);
      setText("[data-model-uso]", selectedModel.uso);
      setText("[data-model-detalle]", selectedModel.detalle);
      setText("[data-spec-field='medida']", selectedModel.medida);
      setText("[data-spec-field='capacidad']", selectedModel.capacidad);
      setText("[data-spec-field='uso']", selectedModel.uso);
      updateWhatsapp();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        selectModel(trigger.getAttribute("data-model-trigger"));
      });
    });

    quoteForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const formData = new FormData(quoteForm);
      const extras = ["nombre", "empresa", "telefono", "ubicacion", "comentarios"]
        .map((key) => {
          const value = String(formData.get(key) || "").trim();
          return value ? `${key}: ${value}` : "";
        })
        .filter(Boolean)
        .join(" | ");
      const message = extras ? `${selectedModel.whatsapp} Datos: ${extras}` : selectedModel.whatsapp;
      window.location.href = buildWhatsappHref(message);
    });

    updateWhatsapp();
  </script>
