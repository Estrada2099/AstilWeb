  <section class="section faq-section">
    <div class="baper-wrap">
      <div class="baper-section-head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Preguntas frecuentes sobre <span data-model-name>{modeloInicial.nombre}</span></h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item">
            <summary>
              <span class="faq-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="faq-question" data-faq-question={index}>{faq.question}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer">
              <p data-faq-answer={index}>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="baper-wrap final-cta__inner">
      <p class="eyebrow">Cotizacion rapida</p>
      <h2>Cotiza <span data-model-name>{modeloInicial.nombre}</span></h2>
      <p>
        <span data-model-help>{modeloInicial.ayuda}</span> Si no estas seguro, revisamos tu tipo
        de carga, espacio disponible y capacidad necesaria antes de recomendar.
      </p>
      <div class="baper-actions">
        <a class="button baper-button--whatsapp" href={whatsappHref} data-dynamic-whatsapp>
          Solicita cotizacion por WhatsApp
        </a>
        <a class="button secondary" href="#modelos-comerciales">Cambiar modelo</a>
      </div>
    </div>
  </section>

  <div class="mobile-sticky-cta" aria-label="Accesos rapidos">
    <a class="button baper-button--whatsapp" href={whatsappHref} data-dynamic-whatsapp>
      WhatsApp
    </a>
    <a class="button secondary" href="#modelos-comerciales">Modelos</a>
  </div>

  <script
    is:inline
    define:vars={{
      modelosComerciales,
      choiceGuides,
      whatsappBase: contact.whatsapp[0].href
    }}
  >
    const modelById = new Map(modelosComerciales.map((model) => [model.id, model]));
    const triggers = document.querySelectorAll("[data-model-trigger]");
    const whatsappLinks = document.querySelectorAll("[data-dynamic-whatsapp]");
    const choiceWhatsappLink = document.querySelector("[data-choice-whatsapp]");
    const quoteForm = document.querySelector("[data-quote-form]");
    let selectedModel = modelosComerciales[1];

    const quoteMessage = (model) =>
      `Hola, quiero cotizar la Bascula de Bajo Perfil Linea Comercial de ${model.medida} con capacidad de ${model.capacidad}.`;
    const choiceMessage = (model) =>
      `Hola, necesito ayuda para confirmar si la Bascula Comercial ${model.medida} es la medida correcta para mi operacion.`;
    const whatsappHrefFor = (message) => `${whatsappBase}?text=${encodeURIComponent(message)}`;
    const setText = (selector, value) => {
      document.querySelectorAll(selector).forEach((node) => {
        node.textContent = value;
      });
    };
    const benefitIconSvg = (icon) =>
      ({
        profile:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 17h16"/><path d="M6 17v-5h12v5"/><path d="M8 12V9h8v3"/><path d="M4 20h16"/></svg>',
        platform:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="1.5"/><path d="M9 3h6"/><path d="M9 21h6"/><path d="M3 9v6"/><path d="M21 9v6"/></svg>',
        capacity:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v3"/><path d="M7 7h10"/><path d="M8 7l-3 6h6L8 7Z"/><path d="M16 7l-3 6h6l-3-6Z"/><path d="M12 7v12"/><path d="M8 20h8"/></svg>',
        surface:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 18h16"/><path d="M7 15h2"/><path d="M11 15h2"/><path d="M15 15h2"/><path d="M6 12h2"/><path d="M10 12h2"/><path d="M14 12h2"/><path d="M18 12h1"/></svg>',
        indicator:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="12" rx="2"/><path d="M7 9h10"/><path d="M8 13h2"/><path d="M12 13h2"/><path d="M16 13h1"/><path d="M10 20h4"/></svg>',
        ramp:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 18h16"/><path d="M5 18 17 8h2v10"/><path d="M8 18v-3"/><path d="M12 18v-6"/></svg>'
      })[icon] ?? "";
    const applicationIconSvg = (icon) =>
      ({
        warehouse:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20h18"/><path d="M5 20V9l7-4 7 4v11"/><path d="M8 20v-7h8v7"/><path d="M10 15h4"/></svg>',
        "package-check":
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8l8-4 8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/><path d="M12 12v8"/><path d="m15 14 2 2 4-5"/></svg>',
        boxes:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="10" width="8" height="8" rx="1"/><rect x="13" y="10" width="8" height="8" rx="1"/><rect x="8" y="4" width="8" height="6" rx="1"/><path d="M7 10v3"/><path d="M17 10v3"/><path d="M12 4v3"/></svg>',
        package:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8l8-4 8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/><path d="M12 12v8"/></svg>',
        box:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10h16"/><path d="M9 5v5"/><path d="M15 5v5"/></svg>',
        truck:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>',
        clock:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg>',
        scale:
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="6" width="14" height="12" rx="2"/><path d="M9 11a3 3 0 0 1 6 0"/><path d="M12 11l2-2"/></svg>'
      })[icon] ?? benefitIconSvg("platform");
    const getUseCases = (model) =>
      model.useCases ?? {
        eyebrow: "Aplicaciones recomendadas",
        title: `Ideal para ${model.usoCorto}`,
        description:
          "Al seleccionar un modelo, esta lista se ajusta a las operaciones donde esa medida tiene mas sentido.",
        cards: model.idealPara.map((item) => ({
          icon: "package",
          title: item,
          text: ""
        }))
      };
    const displayMeasure = (measure) => measure.replace(/ x /g, " × ");
    const displayCapacity = (capacity) =>
      capacity.replace("1000", "1,000").replace("2000", "2,000").replace("3000", "3,000");
    const platformTitle = (model) => `Plataforma Comercial ${displayMeasure(model.medida)}`;
    const specUse = (model) =>
      model.id === "comercial-120" ? "Almacén, recibo, uso frecuente" : model.usoCorto;
    const renderUseCases = (model) => {
      const useCases = getUseCases(model);
      setText("[data-use-eyebrow]", useCases.eyebrow);
      setText("[data-use-title]", useCases.title);
      setText("[data-use-description]", useCases.description);

      const list = document.querySelector("[data-use-cards]");
      if (!list) return;
      list.innerHTML = useCases.cards
        .map(
          (card) =>
            `<article class="use-card">
              <span class="use-card__icon" aria-hidden="true">${applicationIconSvg(card.icon)}</span>
              <div class="use-card__content">
                <strong class="use-card__title">${card.title}</strong>
                ${card.text ? `<p class="use-card__description">${card.text}</p>` : ""}
              </div>
            </article>`
        )
        .join("");
    };
    const renderBenefits = (model) => {
      const list = document.querySelector("[data-benefits-list]");
      if (!list) return;
      list.innerHTML = model.benefitCards
        .map(
          (card) =>
            `<article class="info-card benefit-card">
              <div class="benefit-card__top">
                <span class="card-icon benefit-card__icon" aria-hidden="true">${benefitIconSvg(card.icon)}</span>
                <span class="benefit-card__label">${card.label}</span>
              </div>
              <div class="benefit-card__body">
                <h3>${card.title}</h3>
                <p>${card.text}</p>
              </div>
              <span class="benefit-card__accent" aria-hidden="true"></span>
            </article>`
        )
        .join("");
    };
    const syncSummaryBenefits = (model) => {
      const list = document.querySelector("[data-summary-benefits]");
      if (!list) return;
      list.innerHTML = model.beneficios.map((benefit) => `<li>${benefit}</li>`).join("");
    };
    const renderDecisionList = (selector, items) => {
      const list = document.querySelector(selector);
      if (!list) return;
      list.innerHTML = items.map((item) => `<li>${item}</li>`).join("");
    };
    const renderChoiceGuide = (model) => {
      const guide = choiceGuides[model.id];
      if (!guide) return;
      setText("[data-choice-eyebrow]", guide.eyebrow);
      setText("[data-choice-title]", guide.title);
      setText("[data-choice-intro]", guide.intro);
      renderDecisionList("[data-choice-yes-list]", guide.yes);
      renderDecisionList("[data-choice-other-list]", guide.other);

      document.querySelectorAll("[data-choice-seo]").forEach((node) => {
        node.innerHTML = guide.seoHtml;
      });
    };
    const syncFaqs = (model) => {
      model.faqs.forEach((faq, index) => {
        setText(`[data-faq-question="${index}"]`, faq.question);
        setText(`[data-faq-answer="${index}"]`, faq.answer);
      });

      const schema = document.querySelector("#faq-schema");
      if (schema) {
        schema.textContent = JSON.stringify({
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: model.faqs.map((faq) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: faq.answer
            }
          }))
        });
      }
    };
    const syncWhatsapp = () => {
      const href = whatsappHrefFor(quoteMessage(selectedModel));
      whatsappLinks.forEach((link) => link.setAttribute("href", href));
      choiceWhatsappLink?.setAttribute("href", whatsappHrefFor(choiceMessage(selectedModel)));
    };
    const syncSelectedImages = (model) => {
      document.querySelectorAll(".selected-config-visual--platform img").forEach((img) => {
        img.setAttribute("alt", `Plataforma comercial de bajo perfil ${displayMeasure(model.medida)}`);
      });
    };
    const selectModel = (id) => {
      const nextModel = modelById.get(id);
      if (!nextModel) return;
      selectedModel = nextModel;

      triggers.forEach((trigger) => {
        const isActive = trigger.getAttribute("data-model-trigger") === id;
        trigger.classList.toggle("is-active", isActive);
        if (trigger.getAttribute("role") === "tab") {
          trigger.setAttribute("aria-selected", String(isActive));
        }
        const triggerModel = modelById.get(trigger.getAttribute("data-model-trigger"));
        const badge = trigger.querySelector(".model-card__badge");
        if (badge && triggerModel) {
          badge.textContent = isActive ? "Seleccionado" : triggerModel.etiqueta;
        }
        const cue = trigger.querySelector(".model-card__cue");
        if (cue) {
          cue.textContent = isActive ? "Modelo seleccionado" : "Elegir esta medida";
        }
      });

      setText("[data-model-name]", selectedModel.nombre);
      setText("[data-model-platform-name]", `Plataforma ${selectedModel.medida}`);
      setText("[data-model-measure]", selectedModel.medida);
      setText("[data-model-capacity]", selectedModel.capacidad);
      setText("[data-model-use-short]", selectedModel.usoCorto);
      setText("[data-model-description]", selectedModel.descripcion);
      setText("[data-model-help]", selectedModel.ayuda);
      setText("[data-benefits-intro]", selectedModel.benefitsIntro);
      setText("[data-platform-title]", platformTitle(selectedModel));
      setText("[data-model-code]", selectedModel.modelo);
      setText("[data-spec-field='modelCode']", selectedModel.modelo);
      setText("[data-spec-field='measure']", displayMeasure(selectedModel.medida));
      setText("[data-spec-field='capacity']", displayCapacity(selectedModel.capacidad));
      setText("[data-spec-field='useShort']", specUse(selectedModel));
      renderUseCases(selectedModel);
      renderBenefits(selectedModel);
      syncSummaryBenefits(selectedModel);
      renderChoiceGuide(selectedModel);
      syncFaqs(selectedModel);
      syncSelectedImages(selectedModel);
      syncWhatsapp();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        selectModel(trigger.getAttribute("data-model-trigger"));
      });
    });

    quoteForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const formData = new FormData(quoteForm);
      const extras = ["nombre", "empresa", "telefono", "ubicacion", "comentarios"]
        .map((key) => {
          const value = String(formData.get(key) || "").trim();
          return value ? `${key}: ${value}` : "";
        })
        .filter(Boolean)
        .join(" | ");
      const message = extras
        ? `${quoteMessage(selectedModel)} Datos: ${extras}`
        : quoteMessage(selectedModel);
      window.location.href = whatsappHrefFor(message);
    });

    const useSection = document.querySelector(".applications-section");
    const useMediaImage = document.querySelector(".applications-section .use-media img");
    const deliverySection = document.querySelector(".delivery-section");
    const deliveryMediaImage = document.querySelector(".delivery-section .delivery-media img");
    const desktopMedia = window.matchMedia("(min-width: 1024px)");
    const syncUseMediaScroll = () => {
      if (!useSection || !useMediaImage) return;
      if (!desktopMedia.matches) {
        useMediaImage.style.removeProperty("--use-media-y");
        return;
      }

      const rect = useSection.getBoundingClientRect();
      const progress = Math.min(
        1,
        Math.max(0, (window.innerHeight - rect.top) / (rect.height + window.innerHeight))
      );
      useMediaImage.style.setProperty("--use-media-y", `${18 + progress * 64}%`);
    };
    const syncDeliveryMediaScroll = () => {
      if (!deliverySection || !deliveryMediaImage) return;
      if (!desktopMedia.matches) {
        deliveryMediaImage.style.removeProperty("--delivery-media-shift");
        return;
      }

      const mediaBox = deliveryMediaImage.closest(".delivery-media");
      const rect = deliverySection.getBoundingClientRect();
      const mediaRect = mediaBox?.getBoundingClientRect();
      const progress = Math.min(
        1,
        Math.max(0, (window.innerHeight - rect.top) / (rect.height + window.innerHeight))
      );
      const overflow = Math.max(0, deliveryMediaImage.offsetHeight - (mediaRect?.height ?? 0));
      deliveryMediaImage.style.setProperty("--delivery-media-shift", `${-(overflow * progress)}px`);
    };
    const syncScrollMedia = () => {
      syncUseMediaScroll();
      syncDeliveryMediaScroll();
    };

    window.addEventListener("scroll", syncScrollMedia, { passive: true });
    window.addEventListener("resize", syncScrollMedia);
    desktopMedia.addEventListener?.("change", syncScrollMedia);

    syncWhatsapp();
    syncScrollMedia();
  </script>
</BaseLayout>

