---
import SmartImage from "../../../../components/SmartImage.astro";
import { contact } from "../../../../data/site";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const fichaHref = withBase("/downloads/FHT-BAPER-12.pdf");

const modelosComerciales = [
  {
    id: "comercial-90",
    medida: "90 x 90 cm",
    capacidad: "1000 kg",
    etiqueta: "Compacta",
    uso: "Espacios reducidos, carga compacta y operacion comercial diaria.",
    whatsapp:
      "Hola, quiero cotizar la Bascula de Bajo Perfil Linea Comercial de 90 x 90 cm con capacidad de 1000 kg.",
    detalle:
      "La configuracion compacta para negocios, almacenes pequenos y zonas de recibo donde el espacio manda."
  },
  {
    id: "comercial-120",
    medida: "120 x 120 cm",
    capacidad: "2000 kg",
    etiqueta: "Equilibrada",
    uso: "Almacenes, recibo de mercancia, tarimas y operacion de carga frecuente.",
    whatsapp:
      "Hola, quiero cotizar la Bascula de Bajo Perfil Linea Comercial de 120 x 120 cm con capacidad de 2000 kg.",
    detalle:
      "El punto medio para operacion diaria con tarimas, recibo de mercancia y flujo comercial constante."
  },
  {
    id: "comercial-150",
    medida: "150 x 150 cm",
    capacidad: "3000 kg",
    etiqueta: "Mayor capacidad",
    uso: "Carga de mayor volumen, tarimas grandes y operacion comercial mas robusta.",
    whatsapp:
      "Hola, quiero cotizar la Bascula de Bajo Perfil Linea Comercial de 150 x 150 cm con capacidad de 3000 kg.",
    detalle:
      "La opcion mas amplia de la linea Comercial para tarimas grandes, mayor volumen y cargas mas pesadas."
  }
];

const modeloInicial = modelosComerciales[1];
const whatsappHref = `${contact.whatsapp[0].href}?text=${encodeURIComponent(modeloInicial.whatsapp)}`;
const asesorMessage = encodeURIComponent(
  "Hola, quiero saber que medida de Bascula de Bajo Perfil Linea Comercial me conviene para mi operacion."
);
const whatsappAsesorHref = `${contact.whatsapp[0].href}?text=${asesorMessage}`;

const images = {
  hero: "/Bajo-Perfil/comercial",
  product: "/Bajo-Perfil/comercial",
  benefits: "/Bajo-Perfil/base/base-beneficios2",
  use: "/Bajo-Perfil/base/base-uso-ideal",
  delivery: "/Bajo-Perfil/base/entrega2",
  indicator: "/Bajo-Perfil/base/ipes-producto"
};

const seo = {
  title: "Bascula de Bajo Perfil Comercial 1000 a 3000 kg | Astil Basculas",
  description:
    "Bascula de bajo perfil linea Comercial para almacen, recibo y carga diaria. Modelos 90 x 90, 120 x 120 y 150 x 150 cm con capacidades de 1000 a 3000 kg.",
  keywords:
    "bascula de bajo perfil comercial, bascula de piso comercial, bascula 1000 kg, bascula 2000 kg, bascula 3000 kg, bascula para almacen, bascula para recibo, bascula para tarimas, bascula en CDMX, bascula en Estado de Mexico"
};

const heroBullets = [
  "3 medidas disponibles",
  "Capacidades de 1000 kg a 3000 kg",
  "Plataforma de acero al carbon",
  "Superficie antiderrapante",
  "Indicador digital incluido",
  "Compatible con rampa",
  "Entrega en CDMX y Estado de Mexico"
];

const trustBadges = [
  "Entrega en CDMX y Estado de Mexico",
  "Asesoria antes de comprar",
  "Servicio tecnico disponible",
  "Refacciones e instalacion",
  "Atencion por WhatsApp",
  "Tienda fisica en Texcoco"
];

const supportCards = [
  {
    title: "Seleccion de medida",
    text: "Revisamos espacio, tipo de carga, tarima y capacidad antes de recomendar 90, 120 o 150 cm."
  },
  {
    title: "Entrega local",
    text: "Atendemos entregas programadas en CDMX, Estado de Mexico y zona metropolitana."
  },
  {
    title: "Soporte tecnico",
    text: "Contamos con experiencia en mantenimiento, reparacion y diagnostico de sistemas de pesaje."
  },
  {
    title: "Solucion integral",
    text: "Podemos apoyar con rampas, refacciones, instalacion y servicios posteriores."
  }
];

const benefits = [
  {
    label: "Bajo perfil",
    title: "Acceso practico para carga diaria",
    text: "Facilita la entrada con tarimas, carros o patin hidraulico cuando se agrega rampa."
  },
  {
    label: "3 modelos",
    title: "Tres configuraciones en una misma linea",
    text: "Elige 90 x 90, 120 x 120 o 150 x 150 cm sin cambiar de familia de producto."
  },
  {
    label: "1 a 3 t",
    title: "Capacidad escalable",
    text: "Cubre desde carga compacta de 1000 kg hasta operaciones comerciales de 3000 kg."
  },
  {
    label: "Acero",
    title: "Plataforma de acero al carbon",
    text: "Estructura preparada para uso comercial diario en interior o zona techada."
  },
  {
    label: "Antiderrapante",
    title: "Superficie segura para maniobras",
    text: "Ayuda a mantener control durante carga y descarga de mercancia."
  },
  {
    label: "Digital",
    title: "Indicador incluido",
    text: "Lectura clara para operadores que necesitan pesar sin configuraciones complicadas."
  }
];

const idealUses = [
  "Almacenes",
  "Recibo de mercancia",
  "Comercio mayorista",
  "Centros de distribucion",
  "Embarques",
  "Carga en tarima",
  "Inventario operativo",
  "Operacion diaria controlada"
];

const includes = [
  {
    title: "Plataforma Comercial de bajo perfil",
    image: images.product,
    alt: "Bascula de bajo perfil comercial con plataforma de acero al carbon",
    items: [
      "Medidas disponibles: 90 x 90, 120 x 120 y 150 x 150 cm",
      "Capacidades: 1000, 2000 y 3000 kg",
      "Material: acero al carbon",
      "Superficie antiderrapante",
      "Altura aproximada: 11 cm"
    ]
  },
  {
    title: "Indicador digital incluido",
    image: images.indicator,
    alt: "Indicador digital incluido en bascula de bajo perfil comercial",
    items: [
      "Indicador de solo peso",
      "Pila recargable",
      "Hasta 100 horas de uso continuo",
      "Operacion sencilla para pesaje diario"
    ]
  }
];

const goodFit = [
  "Necesitas pesar todos los dias en almacen, recibo o embarques.",
  "Quieres elegir entre tres medidas sin cambiar de linea.",
  "Trabajas con carga comercial, tarimas o mercancia compacta.",
  "Buscas una solucion robusta, practica y facil de operar.",
  "Necesitas entrega y soporte local en CDMX o Estado de Mexico."
];

const otherLine = [
  "Tu operacion trabaja turnos intensivos con golpes constantes.",
  "Necesitas lavado frecuente, humedad agresiva o ambiente sanitario.",
  "Requieres conectividad avanzada, tickets o integracion con software.",
  "La carga se mueve con montacargas sobre la plataforma.",
  "Necesitas una configuracion especial fuera de 90, 120 o 150 cm."
];

const zones = [
  "Texcoco",
  "Ecatepec",
  "Nezahualcoyotl",
  "Chimalhuacan",
  "Iztapalapa",
  "Gustavo A. Madero",
  "Tlalnepantla",
  "Naucalpan",
  "Cuautitlan",
  "Tultitlan",
  "Coacalco",
  "Los Reyes",
  "Chalco",
  "Zona metropolitana"
];

const platformSpecs = [
  ["Tipo de producto", "Bascula de Bajo Perfil"],
  ["Linea", "Comercial"],
  ["Modelo seleccionado", modeloInicial.medida],
  ["Capacidad maxima", modeloInicial.capacidad],
  ["Altura aproximada", "11 cm"],
  ["Material", "Acero al carbon"],
  ["Superficie", "Antiderrapante"],
  ["Diseno", "Bajo perfil"],
  ["Cable de conexion", "5 metros"],
  ["Compatible con rampa", "Si"],
  ["Celdas de carga", "4 celdas tipo Shearbeam en acero al carbon"],
  ["Uso recomendado", modeloInicial.uso]
];

const indicatorSpecs = [
  ["Indicador de peso", "IPES"],
  ["Linea del indicador", "Comercial"],
  ["Tipo", "Solo peso"],
  ["Estructura", "Plastico"],
  ["Capacidad", "Programable"],
  ["Clase", "MEDIA III"],
  ["Alimentacion", "Cargador 6V"],
  ["Pila", "Recargable, hasta 100 horas de uso continuo"],
  ["Fijacion", "Sin soporte para mesa o pared"],
  ["Conectividad", "N/A"]
];

const faqs = [
  {
    question: "Que modelos tiene la Linea Comercial?",
    answer:
      "La linea Comercial esta disponible en 90 x 90 cm con 1000 kg, 120 x 120 cm con 2000 kg y 150 x 150 cm con 3000 kg."
  },
  {
    question: "Que cambia entre los tres modelos?",
    answer:
      "Cambia la medida de plataforma y la capacidad maxima. La linea, estructura general, indicador, celdas de carga y logica de uso se mantienen."
  },
  {
    question: "Incluye indicador digital?",
    answer: "Si, incluye indicador digital para operacion de solo peso."
  },
  {
    question: "Se puede usar con rampa?",
    answer: "Si, la Linea Comercial es compatible con rampa para facilitar el acceso a la plataforma."
  },
  {
    question: "Sirve para tarimas?",
    answer:
      "Si, especialmente los modelos 120 x 120 y 150 x 150 cm. La recomendacion final depende de la medida de tarima, peso y espacio disponible."
  },
  {
    question: "Que medida me conviene elegir?",
    answer:
      "90 x 90 cm funciona para carga compacta; 120 x 120 cm es el punto medio para almacen y recibo; 150 x 150 cm conviene para tarimas grandes o mayor volumen."
  },
  {
    question: "Hacen entrega en CDMX y Estado de Mexico?",
    answer:
      "Si, atendemos entregas en CDMX, Estado de Mexico y zona metropolitana para empresas, almacenes, comercios y centros de distribucion."
  },
  {
    question: "Puedo cotizar por WhatsApp?",
    answer:
      "Si. Selecciona el modelo en la pagina y el mensaje de WhatsApp se actualiza con la medida y capacidad elegida."
  }
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Bascula de Bajo Perfil Linea Comercial",
  brand: {
    "@type": "Brand",
    name: "Astil Basculas"
  },
  category: "Basculas de bajo perfil",
  material: "Acero al carbon",
  description: seo.description,
  image: [new URL("/Bajo-Perfil/comercial.webp", Astro.site ?? Astro.url).toString()],
  url: new URL("/basculas/bajo-perfil/comercial/", Astro.site ?? Astro.url).toString(),
  offers: modelosComerciales.map((modelo) => ({
    "@type": "Offer",
    name: `Bascula de Bajo Perfil Comercial ${modelo.medida} ${modelo.capacidad}`,
    availability: "https://schema.org/InStock",
    priceCurrency: "MXN",
    seller: {
      "@type": "LocalBusiness",
      name: "Astil Basculas",
      telephone: "+52 56 1186 2291",
      email: contact.email
    },
    itemOffered: {
      "@type": "Product",
      name: `Bascula de Bajo Perfil Comercial ${modelo.medida}`,
      additionalProperty: [
        { "@type": "PropertyValue", name: "Capacidad maxima", value: modelo.capacidad },
        { "@type": "PropertyValue", name: "Dimensiones de plataforma", value: modelo.medida },
        { "@type": "PropertyValue", name: "Uso recomendado", value: modelo.uso }
      ]
    }
  }))
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Basculas de bajo perfil",
      item: new URL("/basculas/bajo-perfil/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Linea Comercial",
      item: new URL("/basculas/bajo-perfil/comercial/", Astro.site ?? Astro.url).toString()
    }
  ]
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  image="/Bajo-Perfil/comercial.webp"
  canonical="/basculas/bajo-perfil/comercial/"
  footerContactHref="#cotizar-comercial"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="baper-hero">
    <div class="baper-wrap baper-hero__grid">
      <div class="baper-hero__copy">
        <p class="eyebrow">Bascula de Bajo Perfil · Linea Comercial</p>
        <h1>Bascula de bajo perfil comercial para almacen, recibo y carga diaria</h1>
        <p class="baper-lead">
          Linea Comercial disponible en 90 x 90, 120 x 120 y 150 x 150 cm, con capacidades de
          1000 kg, 2000 kg y 3000 kg. Ideal para operaciones que necesitan una bascula practica,
          robusta y facil de operar.
        </p>

        <div class="hero-selector" aria-label="Selector rapido de modelo">
          <p>Elige una configuracion</p>
          <div class="model-picker model-picker--hero" role="tablist" aria-label="Modelos disponibles">
            {
              modelosComerciales.map((modelo, index) => (
                <button
                  class:list={["model-option", { "is-active": index === 1 }]}
                  type="button"
                  role="tab"
                  aria-selected={index === 1 ? "true" : "false"}
                  data-model-trigger={modelo.id}
                >
                  <span class="model-option__status">{index === 1 ? "Seleccionado" : modelo.etiqueta}</span>
                  <strong>{modelo.medida}</strong>
                  <span>{modelo.capacidad}</span>
                </button>
              ))
            }
          </div>
        </div>

        <ul class="baper-quick-list" aria-label="Datos principales de la Linea Comercial">
          {heroBullets.map((item) => <li>{item}</li>)}
        </ul>
        <div class="baper-actions">
          <a class="button baper-button--whatsapp" href={whatsappHref} data-dynamic-whatsapp>
            Cotizar por WhatsApp
          </a>
          <a class="button secondary" href="#modelos-comerciales">Ver modelos disponibles</a>
        </div>
        <p class="baper-microcopy">
          Te ayudamos a elegir la medida correcta segun tu tipo de carga y espacio disponible.
        </p>
      </div>
      <div class="baper-hero__media" aria-label="Bascula de bajo perfil Linea Comercial">
        <SmartImage
          name={images.hero}
          fallbackExt="webp"
          alt="Bascula de bajo perfil comercial para almacen, recibo y carga diaria"
          loading="eager"
          width="1600"
          height="1200"
        />
        <article class="selected-summary" aria-live="polite">
          <span>Modelo seleccionado</span>
          <strong data-model-medida>{modeloInicial.medida}</strong>
          <p>
            <b data-model-capacidad>{modeloInicial.capacidad}</b>
            <span data-model-uso>{modeloInicial.uso}</span>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Compra con respaldo de especialistas en pesaje">
    <div class="baper-wrap">
      <p class="trust-strip__title">Compra con respaldo de especialistas en pesaje</p>
      <div class="trust-strip__scroller">
        {trustBadges.map((item) => (
          <article>
            <span aria-hidden="true">V</span>
            <strong>{item}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section model-section" id="modelos-comerciales">
    <div class="baper-wrap">
      <div class="baper-section-head">
        <p class="eyebrow">Selector comparativo de modelos</p>
        <h2>Una misma linea Comercial, tres medidas disponibles</h2>
        <p>
          Selecciona la plataforma que mejor se ajusta a tu espacio, tarima y capacidad de carga.
          La ficha visible y los enlaces de WhatsApp se actualizan con tu eleccion.
        </p>
      </div>

      <div class="model-comparison">
        <div class="model-picker model-picker--comparison" role="tablist" aria-label="Comparar modelos comerciales">
          {
            modelosComerciales.map((modelo, index) => (
              <button
                class:list={["model-card", { "is-active": index === 1 }]}
                type="button"
                role="tab"
                aria-selected={index === 1 ? "true" : "false"}
                data-model-trigger={modelo.id}
              >
                <span>{modelo.etiqueta}</span>
                <strong>{modelo.medida}</strong>
                <b>{modelo.capacidad}</b>
                <small>{modelo.uso}</small>
              </button>
            ))
          }
        </div>

        <article class="model-detail" aria-live="polite">
          <p class="eyebrow">Resumen seleccionado</p>
          <h3><span data-model-medida>{modeloInicial.medida}</span> / <span data-model-capacidad>{modeloInicial.capacidad}</span></h3>
          <p data-model-detalle>{modeloInicial.detalle}</p>
          <dl>
            <div>
              <dt>Medida</dt>
              <dd data-model-medida>{modeloInicial.medida}</dd>
            </div>
            <div>
              <dt>Capacidad</dt>
              <dd data-model-capacidad>{modeloInicial.capacidad}</dd>
            </div>
            <div>
              <dt>Uso recomendado</dt>
              <dd data-model-uso>{modeloInicial.uso}</dd>
            </div>
          </dl>
          <a class="button baper-button--whatsapp" href={whatsappHref} data-dynamic-whatsapp>
            Cotizar este modelo
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section support-section">
    <div class="baper-wrap support-shell">
      <div class="support-copy">
        <p class="eyebrow">Respaldo tecnico Astil Basculas</p>
        <h2>Mas que una bascula: compra con respaldo tecnico</h2>
        <p>
          En Astil Basculas te orientamos para confirmar si la Linea Comercial cubre tu operacion,
          resolvemos dudas tecnicas y contamos con servicio, mantenimiento, refacciones e
          instalacion cuando tu empresa lo requiera.
        </p>
        <div class="baper-actions">
          <a class="button baper-button--whatsapp" href={whatsappAsesorHref}>
            Quiero asesoria por WhatsApp
          </a>
        </div>
      </div>
      <div class="support-grid">
        {supportCards.map((card) => (
          <article class="info-card">
            <span class="card-icon" aria-hidden="true"></span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section benefits-section">
    <div class="baper-wrap benefits-layout">
      <div class="baper-section-head">
        <p class="eyebrow">Beneficios principales</p>
        <h2>Beneficios de la Linea Comercial</h2>
        <p>
          Caracteristicas pensadas para operaciones comerciales que necesitan pesar carga de forma
          practica, estable y repetible durante la jornada.
        </p>
      </div>
      <div class="benefits-media">
        <SmartImage
          name={images.benefits}
          fallbackExt="webp"
          alt="Bascula de bajo perfil comercial con carga en plataforma"
          width="1200"
          height="800"
        />
      </div>
      <div class="benefit-grid">
        {benefits.map((card) => (
          <article class="info-card benefit-card">
            <div class="benefit-card__top">
              <span class="card-icon benefit-card__icon" aria-hidden="true"></span>
              <span class="benefit-card__label">{card.label}</span>
            </div>
            <div class="benefit-card__body">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
            <span class="benefit-card__accent" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section use-section">
    <div class="baper-wrap use-shell">
      <div class="use-copy">
        <div class="baper-section-head">
          <p class="eyebrow">Uso recomendado</p>
          <h2>Ideal para operaciones comerciales e industriales ligeras</h2>
          <p>
            La Linea Comercial funciona bien cuando el pesaje forma parte del flujo diario, pero no
            requiere configuraciones especiales ni ambiente sanitario.
          </p>
        </div>
        <div class="use-grid">
          {idealUses.map((item) => (
            <article>
              <span aria-hidden="true"></span>
              <strong>{item}</strong>
            </article>
          ))}
        </div>
      </div>
      <div class="use-media">
        <SmartImage
          name={images.use}
          fallbackExt="webp"
          alt="Operacion comercial con bascula de bajo perfil para almacen y recibo"
          width="1200"
          height="900"
        />
      </div>
    </div>
  </section>

  <section class="section includes-section">
    <div class="baper-wrap">
      <div class="baper-section-head">
        <p class="eyebrow">Que incluye la Linea Comercial</p>
        <h2>Equipo completo para empezar a pesar</h2>
        <p>
          Los tres modelos comparten estructura general, indicador digital y componentes pensados
          para uso comercial diario.
        </p>
      </div>
      <div class="include-grid">
        {includes.map((item) => (
          <article class="info-card include-card">
            <SmartImage name={item.image} fallbackExt="webp" alt={item.alt} width="1200" height="700" />
            <div>
              <h3>{item.title}</h3>
              <ul>
                {item.items.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section comparison-table-section">
    <div class="baper-wrap">
      <div class="baper-section-head">
        <p class="eyebrow">Comparativa de modelos disponibles</p>
        <h2>Elige por espacio, tarima y peso maximo</h2>
      </div>
      <div class="model-table" role="table" aria-label="Comparativa de modelos Linea Comercial">
        <div role="row" class="model-table__head">
          <span role="columnheader">Modelo</span>
          <span role="columnheader">Medida</span>
          <span role="columnheader">Capacidad</span>
          <span role="columnheader">Mejor para</span>
        </div>
        {
          modelosComerciales.map((modelo, index) => (
            <button
              type="button"
              role="row"
              class:list={["model-table__row", { "is-active": index === 1 }]}
              data-model-trigger={modelo.id}
            >
              <span role="cell">{modelo.etiqueta}</span>
              <strong role="cell">{modelo.medida}</strong>
              <b role="cell">{modelo.capacidad}</b>
              <small role="cell">{modelo.uso}</small>
            </button>
          ))
        }
      </div>
    </div>
