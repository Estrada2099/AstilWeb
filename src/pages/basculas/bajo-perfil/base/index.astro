  ["Indicador de peso", "IPES"],
  ["Línea del indicador", "Comercial"],
  ["Tipo", "Solo peso"],
  ["Estructura", "Plástico"],
  ["Capacidad", "Programable"],
  ["Clase", "MEDIA III"],
  ["Alimentación", "Cargador 6V"],
  ["Pila", "Recargable, hasta 100 horas de uso continuo"],
