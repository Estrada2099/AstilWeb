    }
  ]
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  image="/Bajo-Perfil/base/Baper-hero.webp"
  canonical="/basculas/bajo-perfil/base/"
  footerContactHref="#cotizar-base"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="baper-hero">
    <div class="baper-wrap baper-hero__grid">
      <div class="baper-hero__copy">
        <p class="eyebrow">Báscula de Bajo Perfil · Línea Base · BAPER-12</p>
        <h1>Báscula de bajo perfil 120 × 120 cm para almacén, recibo y uso moderado</h1>
        <p class="baper-lead">
          Modelo BAPER-12 con capacidad de 1,500 kg, plataforma antiderrapante de acero al
          carbón e indicador digital incluido. Entrega en CDMX y Estado de México.
        </p>
        <ul class="baper-quick-list" aria-label="Datos principales de la Báscula BAPER-12">
          {heroBullets.map((item) => <li>{item}</li>)}
        </ul>
        <div class="baper-actions">
          <a class="button baper-button--whatsapp" href={whatsappHref}>Cotizar por WhatsApp</a>
          <a class="button secondary" href={fichaHref} download>Descargar ficha técnica</a>
        </div>
        <p class="baper-microcopy">
          Te ayudamos a confirmar si esta línea es adecuada para tu operación antes de comprar.
        </p>
      </div>
      <div class="baper-hero__media" aria-label="Báscula de bajo perfil BAPER-12">
        <SmartImage
          name={images.hero}
          fallbackExt="webp"
          alt="Báscula de bajo perfil 120 x 120 cm para almacén en CDMX y Estado de México"
          loading="eager"
          width="1600"
          height="900"
        />
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Compra con respaldo de especialistas en pesaje">
    <div class="baper-wrap">
      <p class="trust-strip__title">Compra con respaldo de especialistas en pesaje</p>
      <div class="trust-strip__scroller">
        {trustBadges.map((item) => (
          <article>
            <span aria-hidden="true">✓</span>
            <strong>{item}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section support-section">
    <div class="baper-wrap support-shell">
      <div class="support-copy">
        <p class="eyebrow">Respaldo técnico Astil Básculas</p>
        <h2>Más que una báscula: compra con respaldo técnico</h2>
        <p>
          En Astil Básculas no solo vendemos el equipo. Te orientamos para confirmar si la línea
          Base es adecuada para tu operación, resolvemos dudas técnicas y contamos con servicio,
          mantenimiento, refacciones e instalación cuando tu empresa lo requiera.
        </p>
        <div class="baper-actions">
          <a class="button baper-button--whatsapp" href={whatsappFitHref}>
            Quiero asesoría por WhatsApp
          </a>
        </div>
        <p class="baper-microcopy">
          Te ayudamos a confirmar si esta línea es adecuada para tu operación antes de cotizar.
        </p>
      </div>
      <div class="support-grid">
        {supportCards.map((card) => (
          <article class="info-card">
            <span class="card-icon" aria-hidden="true">
              {card.icon === "guide" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M8 6h13" />
                  <path d="M8 12h13" />
                  <path d="M8 18h13" />
                  <path d="m3 6 1.3 1.3L6.8 4.8" />
                  <path d="m3 12 1.3 1.3 2.5-2.5" />
                  <path d="m3 18 1.3 1.3 2.5-2.5" />
                </svg>
              )}
              {card.icon === "delivery" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 7h11v10H3z" />
                  <path d="M14 10h4l3 3v4h-7z" />
                  <path d="M7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                  <path d="M18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                </svg>
              )}
              {card.icon === "support" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M14.7 6.3a4 4 0 0 0-5.1 5.1l-5.4 5.4a2 2 0 0 0 2.8 2.8l5.4-5.4a4 4 0 0 0 5.1-5.1l-2.9 2.9-2.6-2.6z" />
                </svg>
              )}
              {card.icon === "solution" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 3 4 7l8 4 8-4z" />
                  <path d="m4 12 8 4 8-4" />
                  <path d="m4 17 8 4 8-4" />
                </svg>
              )}
            </span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section benefits-section">
    <div class="baper-wrap benefits-layout">
      <div class="baper-section-head">
        <p class="eyebrow">Beneficios principales</p>
        <h2>Beneficios de la Báscula de Bajo Perfil Base</h2>
        <p>
          Características pensadas para operaciones que necesitan pesar carga de forma práctica,
          clara y sin configuraciones avanzadas.
        </p>
      </div>
      <div class="benefits-media">
        <SmartImage
          name={images.use}
          fallbackExt="webp"
          alt="Báscula de bajo perfil en uso para almacén y recibo"
          width="1200"
          height="800"
          class="benefits-media__mobile"
          pictureClass="benefits-media__mobile-picture"
        />
        <SmartImage
          name={images.benefitsDesktop}
          fallbackExt="webp"
          alt="Báscula de bajo perfil con carga controlada e indicador digital"
          width="1200"
          height="800"
          class="benefits-media__desktop"
          pictureClass="benefits-media__desktop-picture"
        />
      </div>
      <div class="benefit-grid">
        {benefits.map((card) => (
          <article class="info-card benefit-card">
            <div class="benefit-card__top">
              <span class="card-icon benefit-card__icon" aria-hidden="true">
                {card.icon === "profile" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 17h16" />
                    <path d="M6 17v-5h12v5" />
                    <path d="M8 12V9h8v3" />
                    <path d="M4 20h16" />
                  </svg>
                )}
                {card.icon === "platform" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="5" y="5" width="14" height="14" rx="1.5" />
                    <path d="M9 3h6" />
                    <path d="M9 21h6" />
                    <path d="M3 9v6" />
                    <path d="M21 9v6" />
                  </svg>
                )}
                {card.icon === "capacity" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 4v3" />
                    <path d="M7 7h10" />
                    <path d="M8 7l-3 6h6L8 7Z" />
                    <path d="M16 7l-3 6h6l-3-6Z" />
                    <path d="M12 7v12" />
                    <path d="M8 20h8" />
                  </svg>
                )}
                {card.icon === "surface" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 18h16" />
                    <path d="M7 15h2" />
                    <path d="M11 15h2" />
                    <path d="M15 15h2" />
                    <path d="M6 12h2" />
                    <path d="M10 12h2" />
                    <path d="M14 12h2" />
                    <path d="M18 12h1" />
                  </svg>
                )}
                {card.icon === "indicator" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="4" y="5" width="16" height="12" rx="2" />
                    <path d="M7 9h10" />
                    <path d="M8 13h2" />
                    <path d="M12 13h2" />
                    <path d="M16 13h1" />
                    <path d="M10 20h4" />
                  </svg>
                )}
                {card.icon === "ramp" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 18h16" />
                    <path d="M5 18 17 8h2v10" />
                    <path d="M8 18v-3" />
                    <path d="M12 18v-6" />
                  </svg>
                )}
              </span>
              <span class="benefit-card__label">{card.label}</span>
            </div>
            <div class="benefit-card__body">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
            <span class="benefit-card__accent" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section use-section">
    <div class="baper-wrap use-shell">
      <div class="use-copy">
        <div class="baper-section-head">
          <p class="eyebrow">Ideal para</p>
          <h2>Ideal para operaciones que necesitan pesar carga de forma práctica</h2>
          <p>
            La BAPER-12 está pensada para negocios y empresas que necesitan controlar peso en
            procesos internos sin requerir conectividad avanzada o instalación en fosa.
          </p>
        </div>
        <div class="use-grid">
          {idealUses.map((item) => (
            <article>
              <span aria-hidden="true">
                {item.icon === "warehouse" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 20V9l9-5 9 5v11" />
                    <path d="M7 20v-8h10v8" />
                    <path d="M7 15h10" />
                    <path d="M10 12v8" />
                    <path d="M14 12v8" />
                  </svg>
                )}
                {item.icon === "packageCheck" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m3 7 9-4 9 4-9 4z" />
                    <path d="M3 7v10l9 4 9-4V7" />
                    <path d="M12 11v10" />
                    <path d="m8 15 2 2 4-5" />
                  </svg>
                )}
                {item.icon === "recycle" && (
                  <svg viewBox="0 0 24 24" fill="none">
