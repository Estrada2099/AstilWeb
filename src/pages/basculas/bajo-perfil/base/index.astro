---
import SmartImage from "../../../../components/SmartImage.astro";
import { contact } from "../../../../data/site";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const fichaHref = withBase("/downloads/FHT-BAPER-12.pdf");
const quoteMessage = encodeURIComponent(
  "Hola, quiero cotizar la Báscula de Bajo Perfil Base BAPER-12 de 120 x 120 cm y 1,500 kg. Me gustaría confirmar si es adecuada para mi operación."
);
const fitMessage = encodeURIComponent(
  "Hola, quiero saber si la Báscula de Bajo Perfil Base BAPER-12 es adecuada para mi operación."
);
const whatsappHref = `${contact.whatsapp[0].href}?text=${quoteMessage}`;
const whatsappFitHref = `${contact.whatsapp[0].href}?text=${fitMessage}`;

const images = {
  hero: "/Bajo-Perfil/base/Baper-hero",
  product: "/Bajo-Perfil/base/base-producto",
  benefits: "/Bajo-Perfil/base/base-beneficios",
  benefitsDesktop: "/Bajo-Perfil/base/base-beneficios2",
  use: "/Bajo-Perfil/base/base-uso-ideal",
  delivery: "/Bajo-Perfil/base/entrega2",
  indicator: "/Bajo-Perfil/base/ipes-producto"
};

const seo = {
  title: "Báscula de Bajo Perfil 120x120 cm 1500 kg | CDMX y Estado de México",
