---
import SmartImage from "../../../../components/SmartImage.astro";
import { contact } from "../../../../data/site";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const fichaHref = withBase("/downloads/FHT-BAPER-12.pdf");
const whatsappMessage = encodeURIComponent(
  "Hola, quiero cotizar la Báscula de Bajo Perfil Base BAPER-12 de 120 x 120 cm y 1,500 kg. Estoy en CDMX o Estado de México y quiero confirmar disponibilidad."
);
const whatsappHref = `${contact.whatsapp[0].href}?text=${whatsappMessage}`;
const imageSlots = {
  heroPlatform: "/Bajo-Perfil/base",
  indicator: "/Pexisa/IndicadoresPeso",
  surfaceDetail: "/Bajo-Perfil/base",
  application: "/Pexisa/PlataformasPiso",
  bundle: "/Bajo-Perfil/base"
};

const seo = {
  title: "Báscula de Bajo Perfil Base BAPER-12 120x120 cm 1500 kg | Entrega en CDMX y Estado de México",
  description:
    "Báscula de bajo perfil Base BAPER-12 de 120 x 120 cm, altura de 11 cm y capacidad de 1,500 kg. Ideal para almacén, recibo y uso moderado. Entrega en CDMX y Estado de México sin cargo adicional.",
  keywords:
    "BAPER-12, báscula de bajo perfil, báscula de piso, báscula industrial de piso, báscula 120 x 120 cm, báscula de 1500 kg, báscula para almacén, báscula para recibo de mercancía, báscula para embarques, báscula industrial en CDMX, báscula de piso en Estado de México"
};

const quickFacts = [
  { value: "1,500 kg", label: "Capacidad máxima" },
  { value: "120 × 120 cm", label: "Plataforma" },
  { value: "11 cm", label: "Altura" },
  { value: "Acero al carbón", label: "Material" },
  { value: "Compatible", label: "Rampa" },
  { value: "100 horas", label: "Pila recargable" }
];

const trustItems = [
  {
    title: "Diseño de bajo perfil",
    text: "Facilita operaciones de pesaje básico sin instalación compleja."
  },
  {
    title: "Superficie antiderrapante",
    text: "Ayuda a mejorar seguridad y estabilidad durante la carga."
  },
  {
    title: "Capacidad de 1,500 kg",
    text: "Adecuada para carga controlada en almacén, recibo y distribución."
  },
  {
    title: "Compatible con rampa",
    text: "Permite facilitar carga y descarga con una configuración adecuada."
  },
  {
    title: "Indicador IPES incluido",
    text: "Indicador comercial de solo peso, práctico para operación sencilla."
  },
  {
    title: "Pila hasta 100 horas",
    text: "Indicador con batería recargable para uso continuo."
  }
];

const idealUses = [
  {
    title: "Almacenes",
    text: "Pesaje funcional para control interno y movimientos de mercancía."
  },
  {
    title: "Recibo de mercancía",
    text: "Verifica entradas de producto sin complicar la operación diaria."
  },
  {
    title: "Recicladoras",
    text: "Pesaje básico para materiales y control interno no intensivo."
  },
  {
    title: "Pequeños negocios de distribución",
    text: "Apoyo para entradas, salidas y carga controlada."
  },
  {
    title: "Pesaje básico",
    text: "Operación sencilla con indicador de solo peso."
  },
  {
    title: "Control de peso no intensivo",
    text: "Procesos internos con uso moderado y ambiente controlado."
  }
];

const productFeatures = [
  "Plataforma de 120 × 120 cm",
  "Altura de 11 cm",
  "Capacidad máxima de 1,500 kg",
  "Fabricación en acero al carbón",
  "Superficie antiderrapante",
  "4 celdas tipo Shearbeam",
  "Cable de conexión de 5 metros",
  "Compatible con rampa"
];

const platformSpecs = [
  ["Tipo de producto", "Báscula de Bajo Perfil"],
  ["Línea", "Base"],
  ["Modelo", "BAPER-12"],
  ["Capacidad máxima", "1,500 kg"],
  ["Dimensiones de plataforma", "120 × 120 cm"],
  ["Altura", "11 cm"],
  ["Material de fabricación", "Acero al carbón"],
  ["Superficie", "Antiderrapante"],
  ["Diseño", "Bajo perfil"],
  ["Cable de conexión", "5 metros"],
  ["Compatible con rampa", "Sí"],
  ["Celdas de carga", "4 celdas tipo Shearbeam en acero al carbón"],
  ["Uso recomendado", "Almacén, recibo y uso moderado"]
];

const indicatorSpecs = [
  ["Indicador de peso", "IPES"],
  ["Línea del indicador", "Comercial"],
  ["Tipo", "Solo peso"],
  ["Estructura", "Plástico"],
  ["Capacidad", "Programable"],
  ["Clase", "MEDIA III"],
  ["Alimentación", "Cargador 6V"],
  ["Pila", "Recargable, hasta 100 horas de uso continuo"],
  ["Fijación", "Sin soporte para mesa o pared"],
  ["Conectividad", "N/A"]
];

const includes = [
  "Plataforma de bajo perfil 120 × 120 cm",
  "Capacidad máxima de 1,500 kg",
  "Superficie antiderrapante",
  "4 celdas tipo Shearbeam en acero al carbón",
  "Cable de conexión de 5 metros",
  "Indicador IPES de solo peso",
  "Cargador 6V",
  "Pila recargable de hasta 100 horas",
  "Compatibilidad con rampa"
];

const goodFit = [
  "Necesitas una báscula funcional para almacén o recibo.",
  "Tu operación es moderada.",
  "Buscas una solución práctica y accesible.",
  "Trabajas con carga controlada.",
  "Necesitas una plataforma de 120 × 120 cm.",
  "No necesitas conectividad a PC o impresora.",
  "Buscas indicador sencillo de solo peso."
];

const considerOther = [
  "Necesitas uso intensivo durante varios turnos.",
  "Necesitas instalación en fosa.",
  "Requieres conexión RS232 a PC o impresor térmico.",
  "Trabajas en humedad, lavado o ambiente sanitario.",
  "Necesitas capacidades superiores o configuraciones especiales."
];

const faqs = [
  {
    question: "¿Qué capacidad tiene la Báscula de Bajo Perfil Base BAPER-12?",
    answer: "Tiene capacidad máxima de 1,500 kg."
  },
  {
    question: "¿Qué medida tiene la plataforma?",
    answer: "La plataforma mide 120 × 120 cm."
  },
  {
    question: "¿Qué altura tiene la báscula?",
    answer: "Tiene una altura aproximada de 11 cm."
  },
  {
    question: "¿De qué material está fabricada?",
    answer: "Está fabricada en acero al carbón con superficie antiderrapante."
  },
  {
    question: "¿Incluye indicador de peso?",
    answer: "Sí, incluye indicador IPES de línea comercial, tipo solo peso."
  },
  {
    question: "¿Tiene pila recargable?",
    answer: "Sí, el indicador cuenta con pila recargable de hasta 100 horas de uso continuo."
  },
  {
    question: "¿Se le puede colocar rampa?",
    answer: "Sí, es compatible con rampa."
  },
  {
    question: "¿Sirve para fosa?",
    answer:
      "No es la opción recomendada para instalación en fosa. Para ese caso conviene revisar otras líneas."
  },
  {
    question: "¿Tiene conexión a PC o impresora?",
    answer:
      "No, la línea Base no incluye conectividad. Si se requiere conexión a PC o impresor térmico, conviene revisar líneas superiores."
  },
  {
    question: "¿Hacen entrega en CDMX y Estado de México?",
    answer: "Sí, la entrega en CDMX y Estado de México se realiza sin cargo adicional."
  }
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Báscula de Bajo Perfil Base BAPER-12",
  description: seo.description,
  brand: {
    "@type": "Brand",
    name: "Astil Básculas"
  },
  category: "Báscula industrial de piso",
  image: new URL("/Bajo-Perfil/base.webp", Astro.site ?? Astro.url).toString(),
  url: new URL("/basculas/bajo-perfil/base/", Astro.site ?? Astro.url).toString(),
  additionalProperty: [
    { "@type": "PropertyValue", name: "Modelo", value: "BAPER-12" },
    { "@type": "PropertyValue", name: "Medida", value: "120 × 120 cm" },
    { "@type": "PropertyValue", name: "Capacidad", value: "1,500 kg" },
    { "@type": "PropertyValue", name: "Altura", value: "11 cm" },
    { "@type": "PropertyValue", name: "Material", value: "Acero al carbón" },
    { "@type": "PropertyValue", name: "Superficie", value: "Antiderrapante" },
    { "@type": "PropertyValue", name: "Indicador", value: "IPES, comercial, solo peso" },
    { "@type": "PropertyValue", name: "Pila", value: "Recargable, hasta 100 horas" }
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "MXN",
    availability: "https://schema.org/InStock",
    areaServed: ["CDMX", "Estado de México"],
    seller: {
      "@type": "LocalBusiness",
      name: "Astil Básculas",
      telephone: "+52 56 1186 2291",
      email: contact.email
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Báscula de Bajo Perfil Base BAPER-12",
      item: new URL("/basculas/bajo-perfil/base/", Astro.site ?? Astro.url).toString()
    }
  ]
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  image="/Bajo-Perfil/base.webp"
  canonical="/basculas/bajo-perfil/base/"
  footerContactHref="#cotizar-base"
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="base-hero">
    <div class="base-hero__inner">
      <div class="base-hero__copy">
        <p class="eyebrow">Báscula de Bajo Perfil Base · BAPER-12</p>
        <h1>Báscula de Bajo Perfil Base 120 × 120 cm</h1>
        <p class="base-hero__subheadline">
          Capacidad de 1,500 kg para almacén, recibo y operación moderada
        </p>
        <p class="lead">
          Una solución funcional para pesar mercancía, tarimas y carga controlada en procesos de
          almacén, recibo, recicladoras y pequeños negocios de distribución.
        </p>
        <div class="base-facts" aria-label="Datos rápidos de la báscula">
          {quickFacts.map((fact) => (
            <article>
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </article>
          ))}
        </div>
        <div class="button-row">
          <a class="button" href={whatsappHref}>Solicita cotización por WhatsApp</a>
          <a class="button secondary base-button--light" href={fichaHref} download>
            Descargar ficha técnica
          </a>
        </div>
        <p class="base-microcopy">Entregas en CDMX y Estado de México sin cargo adicional.</p>
      </div>
      <div class="base-hero__visual" aria-label="Composición visual de Báscula de Bajo Perfil Base">
        <div class="base-hero-product">
          <SmartImage
            name={imageSlots.heroPlatform}
            fallbackExt="webp"
            alt="Báscula de Bajo Perfil Base BAPER-12 de 120 x 120 cm"
            loading="eager"
            width="1600"
            height="900"
          />
          <span>Imagen hero plataforma · 1600 × 900 px</span>
        </div>
        <div class="base-hero-indicator">
          <SmartImage
            name={imageSlots.indicator}
            fallbackExt="png"
            alt="Indicador de peso IPES para Báscula de Bajo Perfil Base"
            loading="eager"
            width="900"
            height="700"
          />
          <div>
            <strong>Indicador IPES</strong>
            <span>Comercial · solo peso</span>
          </div>
        </div>
        <div class="base-hero-spec">
          <span>Modelo</span>
          <strong>BAPER-12</strong>
          <p>120 × 120 cm · 1,500 kg · altura 11 cm</p>
        </div>
      </div>
    </div>
  </section>

  <section class="base-trust" aria-label="Beneficios rápidos">
    <div class="section-inner base-benefits-layout">
      <div class="base-benefits-media">
        <div class="base-trust__heading">
          <p class="eyebrow">Beneficios</p>
          <h2>Por qué elegir la Báscula Base</h2>
          <p>
            Una solución práctica para operaciones de pesaje básico que requieren funcionalidad,
            seguridad y uso sencillo.
          </p>
        </div>
        <div class="base-media-card">
          <SmartImage
            name={imageSlots.surfaceDetail}
            fallbackExt="webp"
            alt="Detalle visual de superficie antiderrapante para báscula de bajo perfil"
            width="1200"
            height="800"
          />
          <span>Espacio imagen detalle de superficie · 1200 × 800 px</span>
        </div>
        <a class="button" href={whatsappHref}>Solicita cotización por WhatsApp</a>
      </div>
      <div class="base-trust__grid">
        {trustItems.map((item) => (
          <article>
            <span class="base-benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 17h16" />
                <path d="M6 17V9l6-3 6 3v8" />
                <path d="M9 13h6" />
              </svg>
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section base-section">
    <div class="section-inner base-split-heading">
      <div>
        <p class="eyebrow">Uso ideal</p>
        <h2>Ideal para pesaje básico en operación moderada</h2>
      </div>
      <p>
        La Báscula de Bajo Perfil Base BAPER-12 es una solución funcional para empresas y negocios
        que necesitan pesar productos, materiales o mercancía en procesos de almacén, recibo y
        control interno no intensivo.
      </p>
    </div>
    <div class="section-inner base-application-media">
      <SmartImage
        name={imageSlots.application}
        fallbackExt="png"
        alt="Aplicación de báscula de bajo perfil en almacén y recibo"
        width="1600"
        height="1000"
      />
      <span>Espacio imagen aplicación · almacén / recibo / recicladora · 1600 × 1000 px</span>
    </div>
    <div class="section-inner base-use-grid">
      {idealUses.map((item) => (
        <article>
          <span class="base-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 8h16v10H4z" />
              <path d="M7 8V5h10v3" />
              <path d="M8 13h8" />
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section base-product-section">
    <div class="section-inner base-product">
      <div class="base-product__image">
        <SmartImage
          name={imageSlots.heroPlatform}
          fallbackExt="webp"
          alt="Plataforma de acero al carbón de la Báscula de Bajo Perfil Base"
          width="1400"
          height="1000"
        />
        <span>Espacio imagen producto recortado · 1400 × 1000 px</span>
      </div>
      <div class="base-product__content">
        <p class="eyebrow">Conoce el equipo</p>
        <h2>Conoce la Báscula de Bajo Perfil Base BAPER-12</h2>
        <ul class="base-check-list">
          {productFeatures.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section base-includes-section">
    <div class="section-inner base-includes-hero">
      <div>
        <p class="eyebrow">Configuración incluida</p>
        <h2>Qué incluye la Báscula BAPER-12</h2>
        <p>
          Esta configuración integra los componentes oficiales del equipo para operación de pesaje
          básico. No se agregan accesorios no confirmados antes de revisar la aplicación.
        </p>
        <a class="button" href={whatsappHref}>Solicita cotización por WhatsApp</a>
      </div>
      <div class="base-includes-visual">
        <SmartImage
          name={imageSlots.bundle}
          fallbackExt="webp"
          alt="Conjunto de plataforma e indicador de la Báscula BAPER-12"
          width="1400"
          height="900"
        />
        <span>Espacio imagen conjunto · plataforma + indicador · 1400 × 900 px</span>
      </div>
    </div>
    <div class="section-inner base-include-grid">
      {includes.map((item) => (
        <article>
          <span class="base-include-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="m5 12 4 4L19 6" />
            </svg>
          </span>
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section base-specs">
    <div class="section-inner base-split-heading">
      <div>
        <p class="eyebrow">Especificaciones técnicas</p>
        <h2>Plataforma e indicador digital</h2>
      </div>
      <p>
        La información técnica se separa por equipo e indicador para revisar capacidades,
        componentes y limitaciones sin depender de una tabla pesada en celular.
      </p>
    </div>
    <div class="section-inner base-spec-grid">
      <article class="base-spec-card">
        <div class="base-spec-card__heading">
          <span>01</span>
          <div>
            <h3>Plataforma / Equipo</h3>
            <p>Bajo perfil, acero al carbón y superficie antiderrapante.</p>
          </div>
        </div>
        <dl class="base-spec-list">
          {platformSpecs.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </article>
      <article class="base-spec-card">
        <div class="base-spec-card__heading">
          <span>02</span>
          <div>
            <h3>Indicador digital</h3>
            <p>IPES comercial, solo peso, con pila recargable.</p>
          </div>
        </div>
        <dl class="base-spec-list">
          {indicatorSpecs.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </article>
    </div>
    <div class="section-inner base-spec-cta">
      <a class="button" href={fichaHref} download>Descargar ficha técnica PDF</a>
      <a class="button secondary" href={whatsappHref}>Solicita cotización por WhatsApp</a>
    </div>
  </section>

  <section class="section base-guidance">
    <div class="section-inner">
      <div class="base-guidance__heading">
        <p class="eyebrow">Elección correcta</p>
        <h2>Cuándo elegir la Báscula de Bajo Perfil Base</h2>
        <p>
          Esta línea es ideal si buscas una báscula funcional para almacén, recibo, carga controlada
          y operación de uso moderado.
        </p>
      </div>
      <div class="base-choice-grid">
        <article>
          <h3>Sí te conviene si</h3>
          <ul class="base-check-list">
            {goodFit.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="base-choice-grid__muted">
          <h3>Considera otra línea si</h3>
          <ul class="base-check-list">
            {considerOther.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
      <div class="button-row base-centered-action">
        <a class="button secondary" href={withBase("/basculas/bajo-perfil/#seleccion-bajo-perfil")}>
          Ayúdame a elegir la línea correcta
        </a>
      </div>
    </div>
  </section>

  <section class="base-delivery">
    <div class="section-inner base-delivery__inner">
      <div class="base-delivery__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 21s7-6.1 7-12a7 7 0 0 0-14 0c0 5.9 7 12 7 12Z" />
          <path d="M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">Entrega local</p>
        <h2>Entrega en CDMX y Estado de México sin cargo adicional</h2>
        <p>
          Realizamos entrega de la Báscula de Bajo Perfil Base en CDMX y Estado de México sin cargo
          adicional. Es una opción práctica para almacenes, comercios, recicladoras, áreas de recibo
          y pequeños centros de distribución que necesitan recibir su equipo de forma directa.
        </p>
        <a class="button" href={whatsappHref}>Solicita cotización por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section base-download">
    <div class="section-inner base-download__box">
      <div>
        <p class="eyebrow">Ficha técnica</p>
        <h2>Descarga la ficha técnica de la Báscula BAPER-12</h2>
        <p>
          Consulta la información técnica del equipo, medidas, capacidad, beneficios, aplicaciones y
          especificaciones del indicador antes de solicitar tu cotización.
        </p>
      </div>
      <div class="base-download__actions">
        <a class="button" href={fichaHref} download>Descargar ficha técnica PDF</a>
        <a class="button secondary" href={whatsappHref}>Solicita cotización por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section base-faq">
    <div class="section-inner base-split-heading">
      <div>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>FAQ de la Báscula de Bajo Perfil Base BAPER-12</h2>
      </div>
      <p>
        Respuestas rápidas para saber si esta báscula de piso en Estado de México y CDMX encaja con
        tu operación antes de cotizar.
      </p>
    </div>
    <div class="section-inner base-faq__list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="base-final" id="cotizar-base">
    <div class="section-inner base-final__inner">
      <p class="eyebrow">Cotización</p>
      <h2>Cotiza tu Báscula de Bajo Perfil Base BAPER-12</h2>
      <p>
        Solicita información, confirma disponibilidad y recibe asesoría para saber si esta báscula es
        adecuada para tu operación.
