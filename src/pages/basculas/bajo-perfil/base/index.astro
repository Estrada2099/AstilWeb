    "@type": "Brand",
    name: "Astil Básculas"
  },
  model: "BAPER-12",
  sku: "BAPER-12",
  category: "Básculas de bajo perfil",
  material: "Acero al carbón",
  description:
    "Báscula de bajo perfil de 120 x 120 cm con capacidad de 1500 kg, plataforma de acero al carbón, superficie antiderrapante e indicador digital incluido.",
  image: [
    new URL("/Bajo-Perfil/base/Baper-hero.webp", Astro.site ?? Astro.url).toString(),
    new URL("/Bajo-Perfil/base/base-producto.webp", Astro.site ?? Astro.url).toString()
  ],
  url: new URL("/basculas/bajo-perfil/base/", Astro.site ?? Astro.url).toString(),
  additionalProperty: [
    { "@type": "PropertyValue", name: "Capacidad máxima", value: "1500 kg" },
    { "@type": "PropertyValue", name: "Dimensiones de plataforma", value: "120 x 120 cm" },
    { "@type": "PropertyValue", name: "Altura", value: "11 cm" },
    { "@type": "PropertyValue", name: "Indicador incluido", value: "IPES" },
