---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SmartImage from "../../components/SmartImage.astro";
import { contact } from "../../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const homeAnchor = (id: string) => `${base}#${id}`;
const landingFormHref = "#formulario-concreteras";
const whatsappMessage = encodeURIComponent(
  "Hola, necesito revisar un sistema de pesaje en una planta concretera. Quiero solicitar diagnóstico técnico."
);
const whatsappHref = `${contact.whatsapp[0].href}?text=${whatsappMessage}`;

const seo = {
  title: "Servicio de Básculas para Plantas Concreteras | Astil Básculas",
  description:
    "Servicio técnico para sistemas de pesaje en plantas concreteras: reparación, mantenimiento, calibración coordinada, pruebas metrológicas, refacciones e instalación de componentes. Atención frecuente en zona centro y servicios foráneos en México bajo programación.",
  keywords:
    "servicio de básculas para plantas concreteras, mantenimiento de básculas para plantas de concreto, reparación de sistemas de pesaje para concreteras, calibración de básculas para concreteras, sistemas de pesaje para concreto, pesaje en plantas concreteras, básculas para agregados, básculas para cemento, sistemas de pesaje para aditivos, mantenimiento de dosificadoras de concreto, reparación de básculas industriales en CDMX, servicio de básculas en Estado de México, sistemas de pesaje industrial en México"
};

const services = [
  {
    number: "01",
    title: "Reparación de sistemas de pesaje",
    summary: "Revisión de fallas eléctricas, electrónicas, mecánicas y de comunicación.",
    text:
      "Atendemos fallas eléctricas, electrónicas, mecánicas y de comunicación en sistemas de pesaje utilizados dentro de plantas concreteras.",
    items: [
      "Pesaje de agregados",
      "Pesaje de cemento",
      "Pesaje de aditivos",
      "Tolvas de pesaje",
      "Básculas industriales",
      "Sistemas dosificadores",
      "Indicadores de peso",
      "Celdas de carga",
      "Cajas suma",
      "Cableado y conexiones del sistema"
    ],
    note:
      "El servicio puede realizarse directamente en planta, patio, almacén, centro de distribución, zona de operación o área de dosificación, según las condiciones del equipo y la necesidad del cliente."
  },
  {
    number: "02",
    title: "Mantenimiento preventivo y correctivo",
    summary: "Servicio para reducir fallas, lecturas inestables y desgaste de componentes.",
    text:
      "El mantenimiento preventivo y correctivo ayuda a reducir fallas inesperadas, lecturas inestables, errores de pesaje y desgaste de componentes en sistemas que trabajan bajo operación continua.",
    items: [
      "Celdas de carga",
      "Cajas suma",
      "Indicadores de peso",
      "Cableado",
      "Conectores",
      "Condiciones mecánicas del sistema",
      "Puntos de apoyo",
      "Señal de peso",
      "Estabilidad de lectura",
      "Componentes asociados a la dosificación"
    ],
    note:
      "El objetivo es detectar condiciones que puedan generar variaciones en el pesaje, fallas recurrentes o interrupciones en el proceso de producción."
  },
  {
    number: "03",
    title: "Calibración coordinada con laboratorio acreditado por EMA",
    summary: "Coordinación de evidencia metrológica documentada cuando el cliente la requiere.",
    text:
      "Coordinamos procesos de calibración con laboratorio acreditado por EMA cuando la empresa requiere evidencia metrológica documentada para control interno, sistemas de gestión de calidad, requerimientos documentales o seguimiento técnico del sistema de pesaje.",
    note:
      "Astil Básculas no se presenta como laboratorio acreditado; nuestro servicio consiste en coordinar el proceso con un laboratorio acreditado cuando el cliente lo requiere."
  },
  {
    number: "04",
    title: "Pruebas metrológicas para control interno",
    summary: "Verificación técnica del comportamiento del sistema para seguimiento interno.",
    text:
      "Realizamos pruebas metrológicas con patrones calibrados y con certificado, tomando como referencia la NOM-010-SCFI-1994 cuando aplique, orientadas principalmente a control interno, seguimiento operativo y verificación del comportamiento del sistema de pesaje.",
    itemsIntro: "Este servicio puede aplicarse en sistemas relacionados con:",
    items: [
      "Agregados",
      "Cemento",
      "Aditivos",
      "Tolvas de pesaje",
      "Básculas industriales",
      "Sistemas de dosificación",
      "Equipos de control de peso en planta"
    ],
    note:
      "Este servicio no sustituye una calibración formal con laboratorio acreditado ni debe presentarse como documento con validez oficial. Su propósito principal es el control interno, el seguimiento operativo y la verificación técnica del comportamiento del sistema de pesaje."
  },
  {
    number: "05",
    title: "Refacciones para sistemas de pesaje",
    summary: "Suministro de componentes para sistemas de pesaje industrial en planta.",
    text:
      "Podemos suministrar refacciones y componentes relacionados con sistemas de pesaje industrial utilizados en plantas concreteras.",
    items: [
      "Celdas de carga",
      "Cajas suma",
      "Indicadores de peso",
      "Cableado",
      "Conectores",
      "Componentes de comunicación",
      "Accesorios para básculas industriales",
      "Refacciones para tolvas de pesaje",
      "Componentes para sistemas de dosificación"
    ],
    note:
      "La selección de refacciones debe considerar la capacidad, compatibilidad, condiciones de operación, tipo de señal, ambiente de trabajo y aplicación del sistema dentro de la planta."
  },
  {
    number: "06",
    title: "Instalación de refacciones proporcionadas por el cliente",
    summary: "Instalación previa revisión de compatibilidad, condiciones y viabilidad técnica.",
    text:
      "También podemos instalar refacciones que el cliente ya tenga disponibles, siempre que sean compatibles con el sistema de pesaje, se encuentren en condiciones adecuadas y su aplicación sea técnicamente viable.",
    note:
      "Antes de instalar una refacción proporcionada por el cliente, se revisa el componente para reducir el riesgo de fallas, errores de lectura, daños al sistema, problemas de comunicación o lecturas inestables."
  }
];

const applications = [
  "Básculas para agregados",
  "Básculas para cemento",
  "Sistemas de pesaje de aditivos",
  "Tolvas de pesaje",
  "Dosificadoras",
  "Celdas de carga",
  "Cajas suma",
  "Indicadores de peso",
  "Cableado de señal",
  "Conectores",
  "Sistemas de comunicación relacionados con el pesaje",
  "Básculas camioneras vinculadas a operación de planta",
  "Sistemas de control de peso para producción"
];

const zones = [
  "Base de atención frecuente",
  "CDMX",
  "Área Metropolitana",
  "Estado de México",
  "Querétaro",
  "Puebla",
  "Hidalgo",
  "Zona centro",
  "Servicio foráneo bajo programación",
  "Otros estados previa revisión técnica"
];

const diagnosisCards = [
  {
    number: "01",
    title: "Condiciones del sistema",
    description:
      "Revisamos el estado general del sistema de pesaje, su instalación, puntos de apoyo, conexiones y componentes principales.",
    detects: "fallas físicas, eléctricas o de instalación."
  },
  {
    number: "02",
    title: "Comportamiento en operación real",
    description:
      "Evaluamos cómo se comporta el sistema durante el trabajo normal de la planta, considerando carga, descarga, vibración, humedad, polvo y ritmo operativo.",
    detects: "fallas que aparecen durante la operación diaria."
  },
  {
    number: "03",
    title: "Señal y estabilidad de lectura",
    description:
      "Verificamos estabilidad de peso, variaciones, retorno a cero, ruido en la señal y diferencias entre peso aplicado y peso indicado.",
    detects: "lecturas inestables o falta de repetibilidad."
  },
  {
    number: "04",
    title: "Configuración e indicador",
    description:
      "Revisamos parámetros del indicador, conexiones, comunicación, unidades de medición, capacidad y división mínima.",
    detects: "errores de configuración o comunicación."
  },
  {
    number: "05",
    title: "Componentes mecánicos",
    description:
      "Inspeccionamos apoyos, topes, estructuras, interferencias, montaje de celdas y posibles puntos de fricción.",
    detects: "problemas físicos que afecten el pesaje."
  },
  {
    number: "06",
    title: "Comunicación y cableado",
    description:
      "Revisamos cableado, conectores, cajas suma, continuidad de señal, humedad, falsos contactos y comunicación entre componentes.",
    detects: "fallas eléctricas o problemas de señal."
  }
];

const internalLinks = [
  { label: "Calibración de básculas", href: withBase("/servicios/calibracion/") },
  { label: "Básculas camioneras", href: withBase("/basculas-camioneras/") },
  { label: "Servicios", href: homeAnchor("servicios") },
  { label: "Contacto", href: landingFormHref }
];

const faqs = [
  {
    question: "¿Dan servicio a básculas de plantas concreteras?",
    answer:
      "Sí. Atendemos sistemas de pesaje utilizados en plantas concreteras, incluyendo básculas, tolvas, celdas de carga, cajas suma, indicadores, cableado y componentes relacionados con procesos de dosificación."
  },
  {
    question: "¿Pueden revisar sistemas de pesaje para agregados y cemento?",
    answer:
      "Sí. Podemos revisar sistemas de pesaje para agregados, cemento, aditivos, tolvas y dosificadoras, considerando la aplicación del sistema dentro de la operación de la planta."
  },
  {
    question: "¿Realizan mantenimiento a celdas de carga y cajas suma?",
    answer:
      "Sí. Realizamos revisión y mantenimiento de celdas de carga, cajas suma, cableado, conectores, indicadores de peso y componentes relacionados con sistemas de pesaje industrial."
  },
  {
    question: "¿La calibración es con laboratorio acreditado por EMA?",
    answer:
      "Astil Básculas coordina procesos de calibración con laboratorio acreditado por EMA cuando el cliente requiere evidencia metrológica documentada. No nos presentamos como laboratorio acreditado."
  },
  {
    question: "¿Qué diferencia hay entre calibración y pruebas metrológicas para control interno?",
    answer:
      "La calibración con laboratorio acreditado genera documentación emitida por un laboratorio acreditado, de acuerdo con el alcance aplicable. Las pruebas metrológicas para control interno están orientadas a verificar el comportamiento del sistema de pesaje, dar seguimiento operativo y contar con una referencia interna sobre el funcionamiento del equipo."
  },
  {
    question: "¿Las pruebas metrológicas sustituyen una calibración acreditada?",
    answer:
      "No. Las pruebas metrológicas para control interno no sustituyen una calibración formal con laboratorio acreditado. Están orientadas principalmente a control interno, seguimiento técnico y verificación operativa del sistema de pesaje."
  },
  {
    question: "¿Atienden plantas concreteras fuera de CDMX?",
    answer:
      "Sí. Nuestra atención frecuente se concentra en CDMX, Área Metropolitana, Estado de México, Querétaro, Puebla, Hidalgo y zona centro, pero no estamos limitados a esas zonas. También podemos programar servicio foráneo en otros estados de México, según el alcance del servicio, ubicación y condiciones del equipo."
  },
  {
    question: "¿Pueden instalar refacciones que ya compró el cliente?",
    answer:
      "Sí. Podemos instalar refacciones proporcionadas por el cliente, siempre que sean compatibles con el sistema, se encuentren en condiciones adecuadas y su instalación sea técnicamente viable. Antes de instalarlas, se revisan para reducir riesgos de fallas, lecturas inestables o daños al sistema."
  },
  {
    question: "¿Qué tipo de fallas pueden revisar en una planta concretera?",
    answer:
      "Podemos revisar fallas eléctricas, electrónicas, mecánicas y de comunicación relacionadas con sistemas de pesaje, como lecturas inestables, diferencias de peso, fallas en indicadores, daño en celdas de carga, problemas en cajas suma o errores asociados al sistema de dosificación."
  },
  {
    question: "¿Pueden dar mantenimiento a sistemas de dosificación de concreto?",
    answer:
      "Podemos revisar y dar servicio a los componentes de pesaje relacionados con sistemas de dosificación, como celdas de carga, cajas suma, indicadores, cableado, conexiones y elementos asociados al control de peso."
  }
];

const pageUrl = new URL("/servicios/sistemas-pesaje-plantas-concreteras/", Astro.site ?? Astro.url).toString();
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Servicio técnico para sistemas de pesaje en plantas concreteras",
  serviceType:
    "Reparación, mantenimiento, calibración coordinada, pruebas metrológicas, refacciones e instalación de componentes",
  provider: {
    "@type": "LocalBusiness",
    name: "Astil Básculas",
    telephone: "+52 56 1186 2291",
    email: contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: "Calle Miguel Negrete 527",
      addressLocality: "Texcoco de Mora",
      addressRegion: "Estado de México",
      postalCode: "56170",
      addressCountry: "MX"
    }
  },
  areaServed: [
    "CDMX",
    "Estado de México",
    "Querétaro",
    "Puebla",
    "Hidalgo",
    "Zona centro",
    "México bajo programación"
  ],
  url: pageUrl
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Servicios",
      item: new URL("/#servicios", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Sistemas de pesaje para plantas concreteras",
      item: pageUrl
    }
  ]
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical="/servicios/sistemas-pesaje-plantas-concreteras/"
  image="/concretera.webp"
  footerContactHref={landingFormHref}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="concrete-page">
    <section class="concrete-hero">
      <div class="concrete-hero__inner">
        <div class="concrete-hero__copy">
          <p class="eyebrow">Servicio para plantas concreteras</p>
          <h1>Servicio técnico para sistemas de pesaje en plantas concreteras</h1>
          <p class="lead">
            Reparación, mantenimiento, calibración coordinada, pruebas metrológicas, refacciones e
            instalación de componentes para sistemas de pesaje utilizados en plantas de concreto.
          </p>
          <p>
            En una planta concretera, el pesaje no es un elemento aislado: forma parte directa del
            proceso de dosificación, control de materiales, repetibilidad de mezcla y continuidad
            operativa.
          </p>
          <div class="button-row">
            <a class="button" href={landingFormHref}>Solicitar revisión técnica</a>
            <a class="button secondary" href={landingFormHref}>Cotizar servicio para mi planta</a>
          </div>
          <span class="concrete-hero__microcopy">
            Atención frecuente en zona centro. También programamos servicios foráneos en otros estados de México según alcance y ubicación.
          </span>
        </div>

        <aside
          class="concrete-hero__visual"
          aria-label="Sistema de pesaje industrial en planta concretera para dosificación de agregados y cemento"
        >
          <SmartImage
            name="concretera"
            alt="Sistema de pesaje industrial en planta concretera para dosificación de agregados y cemento"
            loading="eager"
            decoding="async"
          />
        </aside>
      </div>
    </section>

    <section class="section problem-section">
      <div class="section-inner split-heading">
        <div>
          <p class="eyebrow">Problema operativo</p>
          <h2>Sistemas de pesaje que influyen directamente en la dosificación del concreto</h2>
        </div>
        <div>
          <p>
            En una planta concretera, una lectura inestable, una celda de carga dañada, una caja
            suma con falla, un indicador mal configurado o un sistema de pesaje desajustado puede
            afectar el control del proceso.
          </p>
          <p>
            Cuando el pesaje no se comporta de forma estable, la operación puede presentar
            variaciones en la dosificación de agregados, cemento o aditivos. Esto puede impactar en
            el consumo de materiales, la repetibilidad de la mezcla, el seguimiento interno de
            producción y la continuidad del proceso.
          </p>
        </div>
      </div>
    </section>

    <section class="section services-section" aria-labelledby="services-title">
      <div class="section-inner section-heading">
        <p class="eyebrow">Servicios técnicos</p>
        <h2 id="services-title">Servicios para básculas y sistemas de pesaje en plantas concreteras</h2>
        <p>
          En Astil Básculas brindamos servicios enfocados en sistemas de pesaje industrial utilizados
          en plantas de concreto, áreas de dosificación, patios, almacenes, zonas de carga, centros
          de distribución y procesos relacionados con producción.
        </p>
      </div>

      <div class="section-inner service-layout">
        <div class="service-grid">
          {services.map((service) => (
            <a
              class="service-summary-card"
              href={`#servicio-${service.number}`}
              data-service-link
              aria-controls={`servicio-${service.number}`}
            >
              <span class="service-card__number">{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <span class="service-summary-card__cta">Conocer más</span>
            </a>
          ))}
        </div>

        <div class="service-detail-list" aria-label="Detalle técnico de servicios">
          {services.map((service) => (
            <details class="service-detail-card" id={`servicio-${service.number}`}>
              <summary class="service-detail-card__header">
                <span>{service.number}</span>
                <h3>{service.title}</h3>
              </summary>
              <div class="service-detail-card__body">
                <p>{service.text}</p>
                {"itemsIntro" in service && <p class="service-items-intro">{service.itemsIntro}</p>}
                {"items" in service && (
                  <div class="chip-list">
                    {service.items.map((item) => <span>{item}</span>)}
                  </div>
                )}
                {"note" in service && <p class="service-note">{service.note}</p>}
              </div>
            </details>
          ))}
        </div>

        <div class="service-cta">
          <p>
            ¿Tu planta presenta variaciones de peso o fallas en el sistema de dosificación?
            Solicita una revisión técnica para identificar el servicio más adecuado.
          </p>
          <a class="button" href={landingFormHref}>Agendar diagnóstico</a>
        </div>
      </div>
    </section>

    <section class="section applications-section">
      <div class="section-inner split-heading">
        <div>
          <p class="eyebrow">Aplicaciones</p>
          <h2>Aplicaciones donde podemos intervenir</h2>
        </div>
        <p>
          Cada revisión debe considerar el tipo de proceso, las condiciones de trabajo, la
          estabilidad de lectura, el comportamiento del sistema y la función que cumple dentro de la
          planta.
        </p>
      </div>
      <div class="section-inner chip-list chip-list--large">
        {applications.map((application) => <span>{application}</span>)}
      </div>
    </section>

    <section class="section coverage-section">
      <div class="section-inner coverage-grid">
        <div>
          <p class="eyebrow">Cobertura</p>
          <h2>Atención local y foránea para plantas concreteras</h2>
          <p>
            Nuestra atención frecuente se concentra en CDMX, Área Metropolitana, Estado de México,
            Querétaro, Puebla, Hidalgo y zona centro del país.
          </p>
          <p>
            No estamos limitados a esas zonas: también podemos programar servicio foráneo en otros
            estados de México, de acuerdo con el tipo de servicio requerido, ubicación, condiciones
            del equipo y alcance técnico solicitado.
          </p>
        </div>
        <div class="chip-list">
          {zones.map((zone) => <span>{zone}</span>)}
        </div>
      </div>
    </section>

    <section class="section trust-section">
      <div class="section-inner trust-grid">
        <div class="trust-panel">
          <h2>Diagnóstico técnico antes de reemplazar componentes</h2>
          <p>
            Antes de recomendar un cambio de celda de carga, indicador, caja suma, cableado o
            cualquier componente del sistema, revisamos el comportamiento real del equipo en
            operación.
          </p>
          <p>
            El objetivo es identificar si la falla proviene de la instalación, la señal de peso, la
            configuración, los componentes mecánicos, la comunicación o las condiciones de trabajo
            de la planta.
          </p>
          <p>
            Así evitamos reemplazos innecesarios y ayudamos a tomar una decisión técnica más
            precisa.
          </p>
          <ul class="trust-checklist">
            <li>Identificación de causa raíz</li>
            <li>Revisión en condiciones reales de operación</li>
            <li>Recomendaciones técnicas según el sistema instalado</li>
          </ul>
          <a class="trust-panel__button" href={landingFormHref}>Solicitar diagnóstico técnico</a>
        </div>
        <div class="trust-card-grid">
          {diagnosisCards.map((card) => (
            <article class="trust-card">
              <div class="trust-card__top">
                <span class="trust-card__number">{card.number}</span>
              </div>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <p class="trust-card__detects">
                <strong>Permite detectar:</strong> {card.detects}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="section concrete-contact-section"
      id="formulario-concreteras"
      aria-labelledby="concrete-contact-title"
    >
      <div class="section-inner contact-grid">
        <div class="contact-copy">
          <p class="eyebrow">Formulario especializado</p>
          <h2 id="concrete-contact-title">Solicita servicio para sistemas de pesaje en tu planta concretera</h2>
          <p>
            Comparte los datos principales de tu planta y del sistema de pesaje que necesitas
            revisar. Esto nos permitirá orientarte de forma más precisa sobre reparación,
            mantenimiento, calibración coordinada, pruebas metrológicas, refacciones o instalación
            de componentes.
          </p>
        </div>

        <form
          class="contact-form"
          data-contact-form
          action="https://formspree.io/f/xjgjnrje"
          method="post"
        >
          <input type="hidden" name="_subject" value="Solicitud desde landing de plantas concreteras" />
          <input type="hidden" name="origen" value="Landing Plantas Concreteras" />
          <input class="form-honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />

          <div class="form-grid">
            <label>
              Nombre
              <input type="text" name="nombre" autocomplete="name" required />
            </label>
            <label>
              Empresa
              <input type="text" name="empresa" autocomplete="organization" required />
            </label>
