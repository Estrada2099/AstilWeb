  <script>
    const form = document.querySelector("[data-contact-form]");
    const status = document.querySelector("[data-form-status]");
    const successModal = document.querySelector("[data-success-modal]");
    const successName = document.querySelector("[data-success-name]");
    const successCloseButtons = document.querySelectorAll("[data-success-close]");
    const serviceLinks = document.querySelectorAll("[data-service-link]");

    serviceLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();

        if (!(link instanceof HTMLAnchorElement)) return;

        const targetId = link.getAttribute("href")?.replace("#", "");
        if (!targetId) return;

        const detail = document.getElementById(targetId);
        if (!(detail instanceof HTMLDetailsElement)) return;

        detail.open = true;
        detail.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", `#${targetId}`);
      });
    });

    if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
      const submitButton = form.querySelector('button[type="submit"]');
      const defaultButtonText = submitButton?.textContent ?? "Solicitar revisión técnica";
      const openSuccessModal = (nombre) => {
        if (!(successModal instanceof HTMLElement)) return;

        if (successName instanceof HTMLElement) {
          successName.textContent = nombre ? `, ${nombre}` : "";
        }

        successModal.hidden = false;
        document.body.classList.add("modal-open");
        successModal.querySelector("button")?.focus();
      };

      const closeSuccessModal = () => {
        if (!(successModal instanceof HTMLElement)) return;
        successModal.hidden = true;
        document.body.classList.remove("modal-open");
      };

      successCloseButtons.forEach((button) => {
        button.addEventListener("click", closeSuccessModal);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeSuccessModal();
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!(submitButton instanceof HTMLButtonElement)) return;

        status.textContent = "";
        status.className = "form-status";
        submitButton.disabled = true;
        submitButton.textContent = "Enviando...";

        try {
          const formData = new FormData(form);
          const nombre = String(formData.get("nombre") ?? "").trim();
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json"
            }
          });

          if (!response.ok) {
            throw new Error("No se pudo enviar el formulario");
          }

          form.reset();
          openSuccessModal(nombre);
        } catch {
          status.textContent =
            "No pudimos enviar la solicitud. Intenta de nuevo o contáctanos por WhatsApp.";
          status.classList.add("is-error");
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = defaultButtonText;
        }
      });
    }
  </script>
