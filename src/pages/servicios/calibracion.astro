---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contact } from "../../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const homeAnchor = (id: string) => `${base}#${id}`;
const whatsappMessage = encodeURIComponent(
  "Hola, quiero solicitar servicio de calibración de básculas. Puedo compartir tipo de báscula, capacidad, ubicación y si requiero certificado."
);
const whatsappHref = `${contact.whatsapp[0].href}?text=${whatsappMessage}`;

const seo = {
  title: "Calibración de Básculas Industriales en CDMX y Estado de México | Astil Básculas",
  description:
    "Servicio de calibración de básculas industriales para empresas en CDMX y Estado de México. Procesos con patrones especializados, certificados y respaldo técnico para operaciones que necesitan precisión, trazabilidad y continuidad.",
  keywords:
    "calibración de básculas, calibración de básculas industriales, servicio de calibración, sistemas de pesaje, básculas industriales, certificado de calibración, trazabilidad, precisión en mediciones, CDMX, Estado de México, Texcoco"
};

const problemItems = [
  "Diferencias entre peso real y peso registrado",
  "Pérdidas económicas por mediciones incorrectas",
  "Problemas en recepción o salida de producto",
  "Rechazos en auditorías o procesos internos",
  "Falta de evidencia documental",
  "Dudas sobre la confiabilidad del equipo"
];

const benefits = [
  {
    title: "Mayor confianza en tus mediciones",
    text: "Ayuda a confirmar si el equipo está pesando dentro de los rangos esperados para tu proceso."
  },
  {
    title: "Evidencia para auditorías",
    text: "El certificado de calibración respalda documentalmente el estado metrológico del equipo."
  },
  {
    title: "Menos riesgo operativo",
    text: "Reduce decisiones basadas en datos incorrectos en recepción, producción, inventario o embarque."
  },
  {
    title: "Mejor control de calidad",
    text: "Apoya procesos donde el peso forma parte de criterios de aceptación, formulación o control."
  },
  {
    title: "Trazabilidad",
    text: "Permite relacionar la medición del equipo con patrones y referencias documentadas."
  },
  {
    title: "Continuidad",
    text: "Ayuda a planear servicios antes de que una desviación genere problemas mayores."
  }
];

const equipmentTypes = [
  "Básculas de plataforma",
  "Básculas de piso",
  "Básculas camioneras",
  "Básculas de bajo perfil",
  "Básculas de mesa",
  "Balanzas",
  "Básculas colgantes",
  "Sistemas de pesaje industriales",
  "Equipos usados en almacén, producción, logística y comercio"
];

const processSteps = [
  {
    title: "Revisión de necesidad",
    text: "Identificamos tipo de báscula, capacidad, ubicación, uso del equipo y objetivo de la calibración."
  },
  {
    title: "Coordinación técnica",
    text: "Definimos las condiciones del servicio, patrones requeridos y alcance necesario."
  },
  {
    title: "Ejecución de la calibración",
    text: "Se realiza el proceso conforme al alcance definido, cuidando la continuidad operativa del cliente."
  },
  {
    title: "Entrega de evidencia",
    text: "Se proporciona la documentación correspondiente para respaldar el resultado del servicio."
  }
];

const differentiators = [
  "Atención directa y comunicación clara",
  "Diagnóstico antes de recomendar",
  "Experiencia en sistemas de pesaje industriales",
  "Servicio orientado a continuidad operativa",
  "Coordinación con laboratorios acreditados aliados",
  "Apoyo con mantenimiento, ajuste, reparación, inspección y venta"
];

const applications = [
  "Industria alimentaria",
  "Industria química",
  "Farmacéutica",
  "Logística y almacenes",
  "Producción",
  "Recepción de materia prima",
  "Embarques",
  "Comercio e inventarios",
  "Control de calidad",
  "Procesos con auditorías internas o externas"
];

const requestChecklist = [
  "Tipo de báscula",
  "Capacidad",
  "Ubicación",
  "Cantidad de equipos",
  "Si requiere certificado",
  "Fecha ideal del servicio"
];

const relatedLinks = [
  { label: "Página principal", href: base },
  { label: "Servicios", href: homeAnchor("servicios") },
  { label: "Contacto", href: homeAnchor("contacto") },
  { label: "Ajuste de peso", href: homeAnchor("servicios"), futureHref: "/servicios/ajuste-de-peso/" },
  { label: "Inspección", href: homeAnchor("servicios"), futureHref: "/servicios/inspeccion/" },
  { label: "Mantenimiento", href: homeAnchor("servicios"), futureHref: "/servicios/mantenimiento/" },
  { label: "Reparación en sitio", href: homeAnchor("servicios"), futureHref: "/servicios/reparacion-en-sitio/" }
];

const faqs = [
  {
    question: "¿Cada cuánto tiempo se debe calibrar una báscula?",
    answer:
      "Depende del uso, capacidad, ambiente de trabajo, criticidad del proceso y requisitos internos o externos de cada empresa. En operaciones industriales suele definirse un programa periódico para mantener evidencia y control."
  },
  {
    question: "¿La calibración corrige el peso de la báscula?",
    answer:
      "No necesariamente. La calibración documenta el comportamiento del equipo. Si se detecta una desviación, puede recomendarse un ajuste de peso o una revisión técnica según el caso."
  },
  {
    question: "¿Entregan certificado de calibración?",
    answer:
      "Sí, el servicio puede incluir la documentación correspondiente al proceso realizado, de acuerdo con el alcance definido para el equipo."
  },
  {
    question: "¿Pueden calibrar en sitio?",
    answer:
      "En muchos casos sí, dependiendo del tipo de báscula, capacidad, ubicación, condiciones del área y patrones necesarios."
  },
  {
    question: "¿Calibran básculas industriales en CDMX y Estado de México?",
    answer:
      "Sí. Astil Básculas atiende empresas en CDMX, Estado de México y zonas cercanas, incluyendo operaciones industriales, comerciales y logísticas."
  },
  {
    question: "¿Qué diferencia hay entre calibración, ajuste e inspección?",
    answer:
      "La calibración documenta el comportamiento metrológico del equipo. El ajuste busca corregir desviaciones. La inspección está relacionada con cumplimiento para uso comercial y puede requerir holograma o verificación según aplique."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical="/servicios/calibracion/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="calibration-page">
    <section class="calibration-hero" aria-labelledby="calibration-title">
      <div class="calibration-hero__inner">
        <div class="calibration-hero__content">
          <p class="eyebrow">Servicio de calibración de básculas</p>
          <h1 id="calibration-title">
            Calibración de básculas industriales para empresas que necesitan precisión y evidencia
          </h1>
          <p class="lead">
            La calibración permite confirmar el comportamiento metrológico de tus equipos de
            pesaje, respaldar tus procesos con evidencia documental y reducir riesgos derivados de
            mediciones incorrectas.
          </p>
          <p>
            En Astil Básculas coordinamos procesos de calibración con patrones especializados y
            alianzas con laboratorios acreditados, ayudando a que tu operación mantenga precisión,
            trazabilidad y continuidad.
          </p>
          <div class="button-row">
            <a class="button" href={homeAnchor("contacto")}>Solicitar calibración</a>
            <a class="button secondary" href={whatsappHref} target="_blank" rel="noreferrer">
              Hablar con un especialista
            </a>
          </div>
        </div>

        <!-- Futuro: reemplazar este bloque por imagen real de calibración, técnico con pesas patrón o báscula industrial. -->
        <aside
          class="calibration-hero__visual"
          aria-label="Espacio para imagen de calibración, técnico con pesas patrón o báscula industrial"
        >
          <div class="visual-frame">
            <span>Imagen futura</span>
            <strong>Calibración / pesas patrón / báscula industrial</strong>
            <p>Contenedor preparado para fotografía técnica del servicio en sitio.</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="section problem-section">
      <div class="section-inner split-heading">
        <div>
          <p class="eyebrow">Riesgo operativo</p>
          <h2>Una báscula fuera de control puede afectar más que el peso</h2>
        </div>
        <p>
          En industria, almacenes, producción y logística, una medición incorrecta puede afectar
          costos, inventarios, calidad, embarques, recepción de materiales y decisiones operativas.
          La calibración de básculas ayuda a convertir una duda técnica en evidencia útil para tu
          operación.
        </p>
      </div>
      <div class="section-inner issue-grid" aria-label="Problemas que ayuda a evitar la calibración">
        {problemItems.map((item) => (
          <article>
            <span aria-hidden="true"></span>
            <h3>{item}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="section definition-section">
      <div class="section-inner">
        <div class="definition-intro">
          <p class="eyebrow">Concepto técnico</p>
          <h2>¿Qué es la calibración de una báscula?</h2>
          <p class="lead">
            La calibración es el proceso mediante el cual se compara el comportamiento de una
            báscula contra patrones de referencia para conocer su error de medición y documentar sus
            resultados.
          </p>
          <p>
            Calibrar no es lo mismo que ajustar. La calibración documenta el comportamiento del
            equipo; el ajuste de peso busca corregir desviaciones cuando el diagnóstico y la
            necesidad del cliente lo requieren.
          </p>
        </div>

        <div class="comparison-grid" aria-label="Comparativa entre calibración y ajuste de peso">
          <article>
            <span>Calibración</span>
            <h3>Verifica y documenta</h3>
            <ul>
              <li>Verifica y documenta el comportamiento del equipo.</li>
              <li>Genera evidencia mediante certificado.</li>
              <li>Ayuda a demostrar trazabilidad y control.</li>
            </ul>
          </article>
          <article>
            <span>Ajuste de peso</span>
            <h3>Corrige cuando es necesario</h3>
            <ul>
              <li>Corrige desviaciones del equipo cuando es necesario.</li>
              <li>Busca acercar la lectura al valor correcto.</li>
              <li>Puede realizarse antes o después según el diagnóstico y necesidad del cliente.</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section benefits-section">
      <div class="section-inner section-heading">
        <p class="eyebrow">Beneficios</p>
        <h2>Beneficios de calibrar tus básculas</h2>
      </div>
      <div class="section-inner benefit-grid">
        {benefits.map((benefit, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section equipment-section">
      <div class="section-inner split-heading">
        <div>
          <p class="eyebrow">Sistemas de pesaje</p>
          <h2>Calibración para diferentes sistemas de pesaje</h2>
        </div>
        <p>
          Atendemos empresas con básculas industriales y equipos de pesaje usados en procesos de
          almacén, producción, logística, comercio y control interno.
        </p>
      </div>
      <div class="section-inner equipment-grid">
        {equipmentTypes.map((item) => <span>{item}</span>)}
      </div>
      <div class="section-inner">
        <p class="technical-note">
          La viabilidad, alcance y condiciones del servicio pueden variar según capacidad,
          ubicación, estado del equipo y requerimientos del cliente.
        </p>
      </div>
    </section>

    <section class="section process-section">
      <div class="section-inner section-heading">
        <p class="eyebrow">Proceso</p>
        <h2>Así trabajamos la calibración</h2>
      </div>
      <div class="section-inner process-grid">
        {processSteps.map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mid-cta" aria-label="Cotizar servicio de calibración">
      <div>
        <p class="eyebrow">Atención técnica directa</p>
        <h2>Agenda una revisión para definir alcance, certificado y condiciones del servicio.</h2>
      </div>
      <a class="button" href={homeAnchor("contacto")}>Cotizar servicio</a>
    </section>

    <section class="section differentiator-section">
      <div class="section-inner differentiator-grid">
        <div>
          <p class="eyebrow">Diferenciador Astil</p>
          <h2>Un servicio técnico pensado para empresas que necesitan claridad</h2>
          <p>
            En Astil Básculas no vemos la calibración como un trámite aislado. La entendemos como
            parte del control técnico de tus sistemas de pesaje. Por eso revisamos el contexto de
            uso, el tipo de operación y la necesidad real antes de recomendar el siguiente paso.
          </p>
          <p>
            No recomendamos una solución sin entender primero el problema real. Si el equipo requiere
            mantenimiento, ajuste, reparación en sitio, inspección o sustitución, lo explicamos con
            criterio técnico y enfoque en continuidad operativa.
          </p>
        </div>
        <ul>
          {differentiators.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section applications-section">
      <div class="section-inner section-heading">
        <p class="eyebrow">Aplicaciones</p>
        <h2>Aplicaciones comunes de la calibración de básculas</h2>
      </div>
      <div class="section-inner application-grid">
        {applications.map((item) => <article><h3>{item}</h3></article>)}
      </div>
    </section>

    <section class="section certificate-section">
      <div class="section-inner certificate-panel">
        <div>
          <p class="eyebrow">Respaldo documental</p>
          <h2>Certificado de calibración y respaldo documental</h2>
        </div>
        <div>
          <p>
            Al finalizar el servicio, el cliente recibe la documentación correspondiente al proceso
            realizado. Esta evidencia puede ser utilizada para auditorías, control interno, sistemas
            de calidad y seguimiento del comportamiento de sus equipos de pesaje.
          </p>
          <p>
            Los procesos pueden realizarse mediante alianzas con laboratorios acreditados, de acuerdo
            con el alcance requerido por el cliente.
          </p>
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="section-inner split-heading">
        <div>
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2>Preguntas sobre calibración de básculas industriales</h2>
        </div>
        <p>
          Estas respuestas ayudan a separar calibración, ajuste e inspección para tomar decisiones
          con mayor claridad técnica.
        </p>
      </div>
      <div class="section-inner faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section related-section">
      <div class="section-inner related-panel">
        <div>
          <p class="eyebrow">Enlaces internos</p>
          <h2>Servicios relacionados</h2>
          <p>
            La calibración puede formar parte de un plan más amplio de control, mantenimiento y
            continuidad para básculas industriales.
          </p>
        </div>
        <nav aria-label="Enlaces internos de servicios">
          {
            relatedLinks.map((link) => (
              <a href={link.href} data-future-route={"futureHref" in link ? link.futureHref : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
        <!-- Futuro: cuando existan páginas individuales, conectar los enlaces con los valores de data-future-route. -->
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div class="final-cta__inner">
        <div>
          <p class="eyebrow">Solicita el servicio</p>
          <h2 id="final-cta-title">Solicita la calibración de tus básculas</h2>
          <p>
            Cuéntanos qué equipo necesitas calibrar, su capacidad, ubicación y el uso que tiene
            dentro de tu operación. Con esa información podemos orientarte con mayor precisión desde
            el primer contacto.
          </p>
          <div class="button-row">
            <a class="button" href={homeAnchor("contacto")}>Solicitar servicio</a>
            <a class="button secondary" href={whatsappHref} target="_blank" rel="noreferrer">
              Enviar WhatsApp
            </a>
          </div>
        </div>
        <aside aria-label="Datos recomendados para solicitar calibración">
          <h3>Para atenderte mejor, comparte:</h3>
          <ul>
            {requestChecklist.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .calibration-page {
    background: #f4f7fb;
  }

  .calibration-hero {
    padding: 82px clamp(18px, 5vw, 72px) 72px;
    background:
      linear-gradient(115deg, rgba(8, 17, 28, 0.96), rgba(16, 32, 51, 0.94)),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 96px),
      #101820;
    color: #ffffff;
  }

  .calibration-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(340px, 0.76fr);
    gap: 48px;
    align-items: center;
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .calibration-hero h1 {
    max-width: 820px;
    margin-bottom: 18px;
    color: #ffffff;
    font-size: 3.85rem;
    line-height: 1;
  }

  .calibration-hero .lead {
    color: #dce7f4;
    font-size: 1.2rem;
  }

  .calibration-hero__content > p:not(.eyebrow, .lead) {
    max-width: 720px;
    margin-bottom: 0;
    color: #b9c7d7;
  }

  .calibration-hero .button {
    border-color: #2f7df6;
    background: #2f7df6;
    box-shadow: 0 14px 30px rgba(47, 125, 246, 0.22);
  }

  .calibration-hero .button.secondary,
  .final-cta .button.secondary {
    border-color: rgba(255, 255, 255, 0.34);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    box-shadow: none;
  }

  .calibration-hero__visual {
    min-height: 430px;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(212, 33, 46, 0.18), transparent 36%),
      rgba(255, 255, 255, 0.06);
  }

  .visual-frame {
    display: grid;
    align-content: end;
    min-height: 398px;
    padding: 24px;
    border: 1px dashed rgba(255, 255, 255, 0.36);
    border-radius: 6px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 18px);
  }

  .visual-frame span {
    width: fit-content;
    margin-bottom: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(47, 125, 246, 0.18);
    color: #dce7f4;
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .visual-frame strong {
    display: block;
    max-width: 320px;
    color: #ffffff;
    font-size: 1.5rem;
    line-height: 1.08;
  }

  .visual-frame p {
    max-width: 330px;
    margin: 12px 0 0;
    color: #b9c7d7;
  }

  .split-heading,
  .definition-intro,
  .differentiator-grid,
  .certificate-panel,
  .final-cta__inner,
  .related-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.72fr);
    gap: 48px;
    align-items: start;
  }

  .split-heading {
    margin-bottom: 32px;
  }

  .split-heading h2,
  .section-heading h2 {
    margin-bottom: 0;
    color: var(--ink);
    font-size: 3rem;
  }

  .split-heading > p,
  .definition-intro > p,
  .certificate-panel p,
  .related-panel p {
    margin-bottom: 0;
    color: var(--muted);
  }

  .problem-section,
  .equipment-section,
  .faq-section {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.46)),
      repeating-linear-gradient(90deg, rgba(67, 95, 120, 0.07) 0 1px, transparent 1px 96px),
      #eef3f8;
  }

  .issue-grid,
  .benefit-grid,
  .process-grid,
  .application-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .issue-grid article,
  .benefit-grid article,
  .process-grid article,
  .application-grid article {
    min-height: 150px;
    padding: 22px;
    border: 1px solid rgba(174, 188, 204, 0.56);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 14px 30px rgba(8, 17, 28, 0.06);
  }

  .issue-grid article {
    display: grid;
    align-content: start;
    gap: 18px;
  }

  .issue-grid span {
    width: 34px;
    height: 4px;
    border-radius: 999px;
    background: var(--red);
  }

  .issue-grid h3,
  .application-grid h3 {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.2;
  }

  .definition-section,
  .benefits-section,
  .process-section,
  .applications-section,
  .related-section {
    background: #ffffff;
  }

  .definition-intro {
    margin-bottom: 28px;
  }

  .definition-intro .lead {
    max-width: none;
    color: #334153;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .comparison-grid article {
    padding: 26px;
    border: 1px solid rgba(174, 188, 204, 0.62);
    border-radius: 8px;
    background: #f8fafc;
  }

  .comparison-grid span,
  .benefit-grid span,
  .process-grid span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 32px;
    margin-bottom: 18px;
    padding: 6px 10px;
    border-radius: 999px;
