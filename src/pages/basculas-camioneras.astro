---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmartImage from "../components/SmartImage.astro";
import { contact } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const homeAnchor = (id: string) => `${base}#${id}`;
const whatsappMessage = encodeURIComponent(
  "Hola, necesito servicio para una báscula camionera. Quiero solicitar diagnóstico y puedo compartir ubicación, falla y capacidad del equipo."
);
const whatsappHref = `${contact.whatsapp[0].href}?text=${whatsappMessage}`;
const landingFormHref = "#formulario-camioneras";

const seo = {
  title: "Básculas Camioneras | Servicio, Reparación y Calibración | Astil Básculas",
  description:
    "Servicio integral para básculas camioneras en CDMX, Área Metropolitana y zona centro. Reparación, mantenimiento, calibración con laboratorio acreditado por ema, inspección, refacciones y software camionero.",
  keywords:
    "servicio para básculas camioneras, básculas camioneras en CDMX, reparación de básculas camioneras, mantenimiento de básculas camioneras, calibración de básculas camioneras, inspección de básculas camioneras, holograma PROFECO báscula camionera, refacciones para básculas camioneras, celdas de carga para báscula camionera, indicador de peso para báscula camionera, caja suma para báscula camionera, software para báscula camionera, sistema camionero para registro de pesajes, básculas de alto alcance, técnicos metrólogos para básculas camioneras, servicio en sitio para básculas camioneras, diagnóstico de básculas camioneras, básculas camioneras Estado de México, básculas camioneras en Texcoco, servicio de básculas camioneras zona centro"
};

const serviceCards = [
  {
    title: "Reparación",
    text: "Atendemos fallas eléctricas, electrónicas, mecánicas y de comunicación directamente en planta, patio, almacén, centro de distribución o zona de operación."
  },
  {
    title: "Mantenimiento preventivo y correctivo",
    text: "Ayudamos a reducir paros inesperados, lecturas inestables, desgaste de componentes y errores de pesaje en operación continua."
  },
  {
    title: "Calibración con laboratorio acreditado por ema",
    text: "Coordinamos procesos de calibración con laboratorio acreditado por ema cuando la empresa requiere evidencia metrológica documentada para control interno, calidad, auditorías o cumplimiento de sistemas de gestión.",
    note: "Este servicio es especialmente importante para empresas que trabajan bajo normas, certificaciones o sistemas de gestión de calidad, como ISO 9001:2015, esquemas de inocuidad, industria alimentaria, auditorías internas o requerimientos documentales de sus clientes."
  },
  {
    title: "Inspección y holograma PROFECO",
    text: "Apoyamos el proceso de inspección o verificación para básculas utilizadas en transacciones comerciales, de acuerdo con el alcance aplicable."
  },
  {
    title: "Refacciones para alto alcance",
    text: "Suministramos celdas de carga, cajas suma, indicadores de peso y componentes relacionados con básculas camioneras."
  },
  {
    title: "Instalación de refacciones proporcionadas por el cliente",
    text: "También podemos instalar refacciones que el cliente ya tenga disponibles, siempre que sean compatibles con el sistema de pesaje y se encuentren en condiciones adecuadas para su instalación.",
    note: "Antes de instalarlas, revisamos el componente y validamos su aplicación para evitar fallas, errores de lectura o daños en la báscula camionera."
  },
  {
    title: "Software camionero",
    text: "Sistema para registrar entradas, salidas, tickets, reportes diarios, usuarios operadores y administración centralizada de pesajes."
  }
];

const compactServiceCards = [
  { card: serviceCards[0], number: "01" },
  { card: serviceCards[1], number: "02" },
  { card: serviceCards[3], number: "04" }
];
const calibrationServiceCard = { card: serviceCards[2], number: "03" };
const partsServiceCards = [
  { card: serviceCards[4], number: "05" },
  { card: serviceCards[5], number: "06" }
];
const softwareServiceCard = { card: serviceCards[6], number: "07" };

const problems = [
  "Diferencias de peso entre entradas y salidas",
  "Lecturas inestables",
  "Variaciones entre secciones de la plataforma",
  "Fallas en celdas de carga",
  "Problemas en caja suma",
  "Daños en indicador de peso",
  "Errores de comunicación",
  "Desajuste de cero",
  "Pesajes inconsistentes",
  "Falta de mantenimiento",
  "Necesidad de calibración o inspección"
];

const diagnosisSteps = [
  "Revisión en sitio",
  "Diagnóstico técnico",
  "Recomendación de alternativas",
  "Ejecución del servicio",
  "Pruebas y seguimiento"
];

const spareParts = [
  "Celdas de carga",
  "Cajas suma",
  "Indicadores de peso",
  "Componentes electrónicos",
  "Accesorios para sistemas camioneros"
];

const softwareFeatures = [
  "Registro de entrada y salida",
  "Tickets de pesaje",
  "Reportes diarios",
  "Vista operador",
  "Vista administrador",
  "Historial de pesajes",
  "Información centralizada",
  "Control de movimientos por báscula"
];

const zones = [
  "CDMX",
  "Estado de México",
  "Texcoco",
  "Área Metropolitana",
  "Hidalgo",
  "Puebla",
  "Querétaro",
  "Zona centro"
];

const differentiators = [
  "Técnicos metrólogos especializados en básculas de alto alcance",
  "Diagnóstico antes de recomendar una solución",
  "Reparación",
  "Mantenimiento preventivo y correctivo",
  "Calibración con laboratorio acreditado por ema",
  "Apoyo para inspección y holograma PROFECO",
  "Venta de refacciones",
  "Distribución autorizada de LOCOSC",
  "Software camionero propio",
  "Soporte 24/7 para casos críticos",
  "Atención a empresas industriales, logísticas, comerciales y de producción"
];

const sectors = [
  "Plantas industriales",
  "Concreteras",
  "Centros de distribución",
  "Almacenes",
  "Recibo y embarques",
  "Industria alimentaria",
  "Empresas de materiales",
  "Recicladoras",
  "Constructoras",
  "Comercializadoras",
  "Productoras",
  "Operaciones con entrada y salida constante de camiones"
];

const internalLinks = [
  { label: "Calibración de básculas", href: withBase("/servicios/calibracion/") },
  { label: "Servicios", href: homeAnchor("servicios") },
  { label: "Software a la medida", href: withBase("/productos/software-a-la-medida/") },
  { label: "Contacto", href: landingFormHref }
];

const faqs = [
  {
    question: "¿Dan servicio a básculas camioneras en sitio?",
    answer:
      "Sí. Atendemos básculas camioneras directamente en sitio para diagnóstico, reparación, mantenimiento, revisión de componentes, ajuste y soporte técnico."
  },
  {
    question: "¿Atienden básculas camioneras en CDMX y Estado de México?",
    answer:
      "Sí. Atendemos principalmente CDMX, Estado de México, Área Metropolitana y zona centro. También podemos revisar proyectos foráneos bajo programación."
  },
  {
    question: "¿Hacen reparación de básculas camioneras?",
    answer:
      "Sí. Realizamos reparación de básculas camioneras, incluyendo revisión de celdas de carga, cajas suma, indicadores de peso, cableado, conexiones, plataforma y fallas de comunicación."
  },
  {
    question: "¿Realizan mantenimiento preventivo?",
    answer:
      "Sí. El mantenimiento preventivo ayuda a reducir fallas, lecturas inestables, desgaste de componentes y paros inesperados en la operación."
  },
  {
    question: "¿La calibración se realiza con laboratorio acreditado por ema?",
    answer:
      "Sí. Podemos coordinar la calibración de básculas camioneras con laboratorio acreditado por ema cuando la empresa requiere evidencia metrológica documentada."
  },
  {
    question: "¿Apoyan con inspección y holograma PROFECO?",
    answer:
      "Sí. Podemos apoyar en el proceso relacionado con inspección o verificación para básculas utilizadas en transacciones comerciales que requieren holograma de PROFECO."
  },
  {
    question: "¿Venden refacciones para básculas camioneras?",
    answer:
      "Sí. Contamos con refacciones para básculas camioneras, como celdas de carga, indicadores de peso, cajas suma y componentes para sistemas de pesaje de alto alcance."
  },
  {
    question: "¿Tienen software para básculas camioneras?",
    answer:
      "Sí. Contamos con software camionero propio para registrar entradas y salidas de camiones, generar tickets, consultar reportes diarios y centralizar el control de pesajes."
  },
  {
    question: "¿Pueden revisar una báscula aunque no sepan exactamente cuál es la falla?",
    answer:
      "Sí. Lo recomendable es iniciar con un diagnóstico técnico para identificar el origen del problema antes de cambiar componentes o realizar ajustes."
  },
  {
    question: "¿Atienden emergencias?",
    answer:
      "Sí. Astil Básculas cuenta con soporte 24/7 para empresas que requieren atención técnica en básculas camioneras y sistemas de pesaje críticos."
  }
];

const pageUrl = new URL("/basculas-camioneras/", Astro.site ?? Astro.url).toString();
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Servicio para básculas camioneras",
  serviceType: "Reparación, mantenimiento, calibración, inspección, refacciones y software para básculas camioneras",
  provider: {
    "@type": "LocalBusiness",
    name: "Astil Básculas",
    telephone: "+52 56 1186 2291",
    email: contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: "Calle Miguel Negrete 527",
      addressLocality: "Texcoco de Mora",
      addressRegion: "Estado de México",
      postalCode: "56170",
      addressCountry: "MX"
    }
  },
  areaServed: ["CDMX", "Estado de México", "Área Metropolitana", "Texcoco", "Hidalgo", "Puebla", "Querétaro", "Zona centro de México"],
  url: pageUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site ?? Astro.url).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Básculas camioneras",
      item: pageUrl
    }
  ]
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical="/basculas-camioneras/"
  footerContactHref={landingFormHref}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="truck-page">
    <section class="truck-hero" aria-labelledby="truck-hero-title">
      <div class="truck-hero__inner">
        <div class="truck-hero__content">
          <p class="eyebrow">Servicio para básculas camioneras</p>
          <h1 id="truck-hero-title">
            Básculas camioneras: servicio integral para pesaje de alto alcance
          </h1>
          <p class="lead">
            Reparación, mantenimiento, calibración con laboratorio acreditado por ema,
            inspección, refacciones y software camionero para empresas que necesitan control,
            precisión y continuidad operativa.
          </p>
          <p>
            Cuando una báscula camionera falla, la operación no puede esperar. Un pesaje incorrecto
            puede afectar inventarios, embarques, costos, facturación, producción y control de
            entradas y salidas.
          </p>
          <div class="button-row">
            <a class="button" href={landingFormHref}>Solicitar diagnóstico</a>
            <a class="button secondary" href={whatsappHref} target="_blank" rel="noreferrer">
              Hablar por WhatsApp
            </a>
          </div>
          <span class="truck-hero__microcopy">
            Atención en CDMX, Área Metropolitana, Estado de México, zona centro y proyectos foráneos bajo programación.
          </span>
        </div>

        <aside
          class="truck-hero__visual"
          aria-label="Báscula camionera industrial para pesaje de camiones en planta de operación"
        >
          <SmartImage
            name="hero-camionera"
            alt="Báscula camionera industrial para pesaje de camiones en planta de operación"
            loading="eager"
            decoding="async"
          />
        </aside>
      </div>
    </section>

    <section class="section truck-services" aria-labelledby="truck-services-title">
      <div class="section-inner split-heading">
        <div>
          <p class="eyebrow">Servicio especializado</p>
          <h2 id="truck-services-title">Servicio especializado para básculas camioneras</h2>
        </div>
        <p>
          Las básculas camioneras trabajan bajo condiciones exigentes: cargas pesadas, tránsito
          constante, humedad, polvo, vibración, golpes, desgaste mecánico y errores derivados de
          instalación, operación o falta de mantenimiento.
        </p>
      </div>

      <div class="section-inner service-layout">
        <div class="service-grid service-grid--compact" aria-label="Servicios técnicos principales">
          {compactServiceCards.map(({ card, number }) => (
            <article class="service-card">
              <span class="service-card__number" aria-hidden="true">{number}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>

        <article class="service-card service-card--feature">
          <div class="service-card__feature-index">
            <span class="service-card__number" aria-hidden="true">{calibrationServiceCard.number}</span>
          </div>
          <div>
            <h3>{calibrationServiceCard.card.title}</h3>
            <p>{calibrationServiceCard.card.text}</p>
            {"note" in calibrationServiceCard.card && (
              <p class="service-note">{calibrationServiceCard.card.note}</p>
            )}
          </div>
        </article>

        <div class="service-related-block" aria-label="Servicios de refacciones">
          {partsServiceCards.map(({ card, number }) => (
            <article class="service-card">
              <span class="service-card__number" aria-hidden="true">{number}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              {"note" in card && <p class="service-note">{card.note}</p>}
            </article>
          ))}
        </div>

        <article class="service-card service-card--feature service-card--software">
          <div class="service-card__feature-index">
            <span class="service-card__number" aria-hidden="true">{softwareServiceCard.number}</span>
          </div>
          <div>
            <h3>{softwareServiceCard.card.title}</h3>
            <p>{softwareServiceCard.card.text}</p>
          </div>
        </article>
      </div>

      <div class="section-inner service-cta">
        <p>Respuesta para empresas con operación de pesaje. Revisamos tu caso antes de recomendar una solución.</p>
        <a class="button" href={landingFormHref}>Agendar revisión en sitio</a>
      </div>
    </section>

    <section class="section problem-band">
      <div class="section-inner problem-grid">
        <div>
          <p class="eyebrow">Problemas comunes</p>
          <h2>Podemos ayudarte si tu báscula presenta fallas de operación</h2>
          <p>
            En Astil Básculas realizamos una revisión técnica para identificar la causa real de la
            falla y definir la mejor alternativa para tu operación.
          </p>
        </div>
        <ul>
          {problems.map((problem) => <li>{problem}</li>)}
        </ul>
      </div>
    </section>

    <section class="section diagnosis-section">
      <div class="section-inner diagnosis-grid">
        <div>
          <p class="eyebrow">Diagnóstico técnico</p>
          <h2>Primero diagnosticamos, después solucionamos</h2>
          <p class="lead">
            En Astil Básculas no llegamos a cambiar piezas solo porque sí. Revisamos el
            comportamiento de la báscula, evaluamos componentes, identificamos posibles causas y
            explicamos al cliente qué alternativas tiene.
          </p>
          <p>
            Desde que llegamos a planta, la báscula pasa a ser nuestra responsabilidad técnica. El
            cliente no tiene que coordinar distintos proveedores ni adivinar qué componente está
            fallando: nosotros revisamos, explicamos, recomendamos y ejecutamos.
          </p>
        </div>
        <ol>
          {diagnosisSteps.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section parts-section">
      <div class="section-inner parts-grid">
        <div>
          <p class="eyebrow">Refacciones</p>
          <h2>Refacciones para básculas camioneras</h2>
          <p>
            Contamos con venta de refacciones para básculas camioneras y equipos de alto alcance.
            Somos distribuidores autorizados de LOCOSC para componentes de pesaje industrial y alto
            alcance.
          </p>
          <p>
            Esto permite reducir tiempos de respuesta y ofrecer una solución más completa cuando la
            báscula requiere reemplazo de componentes.
          </p>
        </div>
        <div class="parts-list">
          {spareParts.map((part) => <span>{part}</span>)}
        </div>
      </div>
    </section>

    <section class="section software-section" aria-labelledby="software-title">
      <div class="section-inner software-grid">
        <div class="software-copy">
          <p class="eyebrow">Control digital</p>
          <h2 id="software-title">Software camionero para controlar cada entrada y salida</h2>
          <p>
            Además del servicio técnico, en Astil Básculas contamos con software camionero propio,
            diseñado para mejorar el control operativo de básculas camioneras.
          </p>
          <p>
            El sistema permite registrar cada entrada y salida de camión, centralizar información,
            generar tickets y consultar reportes para una administración más clara del pesaje.
          </p>
          <div class="button-row">
            <a class="button" href={landingFormHref}>Conocer software camionero</a>
            <a class="button secondary" href={whatsappHref} target="_blank" rel="noreferrer">
              Hablar por WhatsApp
            </a>
          </div>
        </div>

        <aside
          class="software-mockup"
          aria-label="Software camionero para registro de entradas, salidas y reportes de báscula camionera"
        >
          <SmartImage
            name="software-camionero"
            alt="Software camionero para registro de entradas, salidas y reportes de báscula camionera"
            loading="lazy"
            decoding="async"
          />
        </aside>
      </div>

      <div class="section-inner software-feature-grid">
        {softwareFeatures.map((feature) => <span>{feature}</span>)}
      </div>
    </section>

    <section class="section coverage-section">
      <div class="section-inner coverage-grid">
        <div>
          <p class="eyebrow">Cobertura</p>
          <h2>Atención en CDMX, Área Metropolitana y proyectos foráneos</h2>
          <p>
            Atención principal en CDMX, Área Metropolitana, Estado de México y zona centro.
            Proyectos foráneos bajo programación según ubicación, tipo de servicio, urgencia y
            condiciones de la báscula.
          </p>
        </div>
        <div class="zone-list">
          {zones.map((zone) => <span>{zone}</span>)}
        </div>
      </div>
    </section>

    <section class="section why-section">
      <div class="section-inner why-grid">
        <div class="why-panel">
          <p class="eyebrow">Diferenciadores</p>
          <h2>¿Por qué elegir Astil Básculas?</h2>
          <p>
            Una báscula camionera no es un equipo menor. Es un punto crítico de control para compras,
            ventas, inventarios, entregas, producción y logística.
          </p>
          <p>
            No buscamos vender por vender. Buscamos entender qué necesita tu operación y ofrecer una
            solución adecuada para que tu báscula trabaje con precisión y respaldo técnico.
          </p>
          <div class="why-panel__metrics" aria-label="Fortalezas de Astil Básculas">
            <span>Diagnóstico</span>
            <span>Servicio en sitio</span>
            <span>Soporte técnico</span>
          </div>
        </div>
        <ul class="why-card-grid">
          {
            differentiators.map((item, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item}</strong>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section sectors-section">
      <div class="section-inner section-heading">
        <p class="eyebrow">Sectores atendidos</p>
        <h2>Sectores que utilizan básculas camioneras</h2>
        <p>
          En estas operaciones, un error de pesaje puede convertirse en pérdidas, diferencias de
          inventario, problemas de facturación o falta de control documental.
        </p>
      </div>
      <div class="section-inner sector-grid">
        {sectors.map((sector) => <span>{sector}</span>)}
      </div>
    </section>

    <section class="section internal-links-section">
      <div class="section-inner internal-links">
        <div>
          <p class="eyebrow">Soluciones conectadas</p>
          <h2>Servicios relacionados</h2>
        </div>
        <nav aria-label="Enlaces internos relacionados con básculas camioneras">
          {internalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </section>

    <section class="final-truck-cta" aria-labelledby="final-truck-title">
      <div class="final-truck-cta__inner">
        <div>
          <p class="eyebrow">Solicita diagnóstico</p>
          <h2 id="final-truck-title">Solicita diagnóstico para tu báscula camionera</h2>
          <p>
            Si tu báscula camionera presenta fallas, necesita mantenimiento, calibración,
            inspección, refacciones o un sistema para controlar entradas y salidas, podemos ayudarte.
            Cuéntanos qué problema presenta tu equipo y revisamos la mejor alternativa para tu
            operación.
          </p>
          <div class="button-row">
            <a class="button" href={whatsappHref} target="_blank" rel="noreferrer">
              Solicitar diagnóstico por WhatsApp
            </a>
            <a class="button secondary" href={landingFormHref}>
              Cotizar servicio para báscula camionera
            </a>
          </div>
        </div>
        <aside>
          <strong>Para atenderte mejor, comparte:</strong>
          <ul>
            <li>Ubicación de la báscula</li>
            <li>Capacidad aproximada</li>
            <li>Falla o comportamiento observado</li>
            <li>Marca de indicador o celdas si la conoces</li>
            <li>Si requiere calibración, inspección o refacciones</li>
          </ul>
        </aside>
      </div>
    </section>

    <section
      class="section truck-contact-section"
      id="formulario-camioneras"
      aria-labelledby="truck-contact-title"
    >
      <div class="section-inner truck-contact-grid">
        <div class="truck-contact-copy">
          <p class="eyebrow">Formulario especializado</p>
